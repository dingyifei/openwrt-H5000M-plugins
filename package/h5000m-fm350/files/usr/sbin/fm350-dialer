#!/bin/sh
# FM350-GL dialer. Started by the fm350 netifd proto via proto_run_command.
#
# NOTE: the PDP-down counter is deliberately not named BEARER_*: the secret scanner
# (correctly) treats a BEARER_ assignment as a possible bearer token, and a cellular
# "bearer" is an unrelated meaning of the word.
#
# Contract with netifd: publish the granted address with proto_send_update, then stay alive
# and re-publish whenever the network renumbers us. An address change is a re-publish, never
# a re-dial, and a single-family grant is a success.
#
# Deliberately NOT `set -u`: OpenWrt's /lib/functions.sh dereferences $IPKG_INSTROOT unset,
# which would kill this script on source - and netifd respawns a proto command that exits,
# so that is a restart storm, not a one-off.

. /lib/functions.sh
. /lib/netifd/netifd-proto.sh
. /usr/lib/h5000m/atio.sh
. /usr/lib/h5000m/modem-discover.sh

APN_TABLE=/usr/lib/h5000m/apn-table

INTERFACE=""; APN=""; PDP_TYPE="IPV4V6"; APN_TYPE="default"; METRIC=20; MTU=0; PEERDNS=1

while [ $# -gt 0 ]; do
	case "$1" in
		-i) INTERFACE="$2"; shift 2 ;;
		-a) APN="$2"; shift 2 ;;
		-t) PDP_TYPE="$2"; shift 2 ;;
		-y) APN_TYPE="$2"; shift 2 ;;
		-m) METRIC="$2"; shift 2 ;;
		-u) MTU="$2"; shift 2 ;;
		-d) PEERDNS="$2"; shift 2 ;;
		*) shift ;;
	esac
done
[ -n "$INTERFACE" ] || { echo "fm350-dialer: -i <interface> required" >&2; exit 1; }

PIDFILE="/var/run/fm350-${INTERFACE}.pid"
echo $$ > "$PIDFILE"

POLL_INTERVAL=30
REPUBLISH=0
AID=""
LAST_IP=""
PDP_DOWN_STREAK=0
BLACKHOLE=0
LAST_TX=0
LAST_RX=0

log()  { logger -t "fm350[$INTERFACE]" -p daemon.info "$*"; }
warn() { logger -t "fm350[$INTERFACE]" -p daemon.warn "$*"; }

cleanup() { rm -f "$PIDFILE"; }
trap cleanup EXIT
trap 'REPUBLISH=1' USR1

at() {
	at_locked "$(at_lockfile "$MODEM_USBPATH" "$MODEM_AT_A_IF")" 20 \
		"$MODEM_AT_A" "$1" "${2:-8}"
}

# --- address parsing --------------------------------------------------------------
# AT+CGPADDR returns the IPv6 address as SIXTEEN dotted octets, which a naive [0-9.]+
# pattern happily matches as though it were IPv4 - that silently cost a debugging round.
# Select the value with exactly four octets.
ipv4_of() {
	at "AT+CGPADDR=$1" 8 | tr ',' '\n' | tr -d '" ' \
		| awk -F. 'NF==4 && $1 != "" && $1 ~ /^[0-9]+$/ { print; exit }'
}

active_aids() {
	at 'AT+CGACT?' 8 | sed -n 's/.*+CGACT: *\([0-9]*\), *1.*/\1/p'
}

# --- bring-up ---------------------------------------------------------------------
# EXACTLY ONE context may be active. This is the real constraint - not the cid number.
# With two or more live, RNDIS forwards none of them: tx climbs and rx stays at zero.
# Verified by deactivating everything and activating one, which made the very same address
# and route start working. It also explains why "use cid 1" worked for some reporters and
# not others, depending on what else happened to be active at the time.
deactivate_all() {
	for _a in $(active_aids); do
		log "deactivating aid ${_a} (only one context may be active)"
		at "AT+EAPNACT=0,${_a}" 20 >/dev/null 2>&1
	done
	sleep 2
}

# activate <apn> <apn_type> -> echoes the aid the MODEM chose
#
# +EAPNACT rather than +CGACT: it activates by APN name and type, lets the modem pick the
# aid, and never returns the local refusal 5847. AT+CGACT=1,1 cannot succeed where the
# carrier owns cid 1 for IMS (China Telecom does), and no amount of CFUN cycling changes
# that - the refusal is local, confirmed by AT+CEER reporting no network cause at all.
activate() {
	_out=$(at "AT+EAPNACT=1,\"$1\",\"$2\"" 45)
	# Success is the URC, not OK: "+CGEV: ME PDN ACT <aid>,<n>".
	_aid=$(printf '%s' "$_out" | sed -n 's/.*ME PDN ACT \([0-9]*\).*/\1/p' | head -1)
	[ -n "$_aid" ] || return 1
	printf '%s' "$_aid"
}

# The APN TYPE the modem will accept is NOT stable, which cost a debugging round.
# Measured on this unit, same SIM, same carrier, ~an hour apart:
#   session 1: type "default" activated cleanly.
#   session 2: type "default" -> +CME ERROR 5848 with NOTHING active, while "net"
#              activated immediately -> +CGEV: ME PDN ACT 3,2.
# Both refusals are local: AT+CEER reported "+CEER: 0,NONE", i.e. no network cause at all,
# and a CFUN=4/CFUN=1 cycle did not change the outcome. A local refusal that carries no
# reason cannot be predicted, only probed - so try the configured type first, then the
# others, rather than failing the whole bring-up on one type's refusal.
apn_type_ladder() {
	printf '%s\n' "$APN_TYPE"
	for _t in default net tethering; do
		[ "$_t" = "$APN_TYPE" ] || printf '%s\n' "$_t"
	done
}

apn_from_table() {
	_imsi=$(at 'AT+CIMI' 6 | tr -dc '0-9')
	[ -n "$_imsi" ] || return 1
	for _len in 6 5; do
		_key=$(printf '%s' "$_imsi" | cut -c1-"$_len")
		_hit=$(awk -v k="$_key" '$1==k {print $2; exit}' "$APN_TABLE" 2>/dev/null)
		[ -n "$_hit" ] && { printf '%s' "$_hit"; return 0; }
	done
	return 1
}

read_dns() {
	RDP_DNS1=""; RDP_DNS2=""
	_rdp=$(at "AT+CGCONTRDP=$1" 10) || return 1
	RDP_DNS1=$(printf '%s' "$_rdp" | awk -F, '{gsub(/"/,""); print $6}' | head -1)
	RDP_DNS2=$(printf '%s' "$_rdp" | awk -F, '{gsub(/"/,""); print $7}' | head -1)
}

# NOTE: proto_set_keep is deliberately never called. With keep=1 netifd leaves the previous
# address attached across a renumber, giving two addresses and traffic sourced from the dead
# one - a silent, total loss of the uplink.
publish() {
	_ip="$1"
	read_dns "$AID" || true

	# The generic rndis_host profile does not set NOARP for this device (OpenWrt PR #24196
	# adds FLAG_WWAN|POINTTOPOINT|NOARP for 0e8d:7127). Without this the link passes no
	# traffic; with it alone it still does not - both this and the single-context rule are
	# required, which is why either one tested on its own looked like a dead end.
	ip link set "$MODEM_NETDEV" arp off 2>/dev/null
	ip link set "$MODEM_NETDEV" up 2>/dev/null
	[ "$MTU" != 0 ] && ip link set "$MODEM_NETDEV" mtu "$MTU" 2>/dev/null

	proto_init_update "$MODEM_NETDEV" 1
	# Cellular is point-to-point and this modem reports no gateway or netmask; the
	# field-verified convention is the granted address as a /24 with .1 as the next hop.
	proto_add_ipv4_address "$_ip" 24
	proto_add_ipv4_route "0.0.0.0" 0 "${_ip%.*}.1"
	if [ "$PEERDNS" = 1 ]; then
		for _d in "$RDP_DNS1" "$RDP_DNS2"; do
			case "$_d" in
				''|0.0.0.0|*[!0-9.]*) ;;
				*) proto_add_dns_server "$_d" ;;
			esac
		done
	fi
	proto_send_update "$INTERFACE"

	LAST_IP="$_ip"
	log "published ${_ip}/24 gw ${_ip%.*}.1 aid ${AID} dev ${MODEM_NETDEV}"
}

at_state_load || modem_discover_locked || {
	warn "no FM350 on the USB bus"
	proto_notify_error "$INTERFACE" NO_MODEM
	proto_block_restart "$INTERFACE"
	exit 1
}
at_state_load

[ -n "$MODEM_NETDEV" ] || {
	warn "no RNDIS netdev - is kmod-usb-net-rndis installed?"
	proto_notify_error "$INTERFACE" NO_NETDEV
	proto_block_restart "$INTERFACE"
	exit 1
}

at 'AT+CMEE=2' 6 >/dev/null 2>&1
case "$(at 'AT+CPIN?' 8)" in
	*READY*) ;;
	*)
		warn "SIM not ready"
		proto_notify_error "$INTERFACE" SIM_NOT_READY
		proto_block_restart "$INTERFACE"
		exit 1
		;;
esac
at 'AT+CGEREP=2,1' 6 >/dev/null 2>&1

# Registration is a precondition, but there is no radio cycling here: nothing below
# reprovisions the attach context, so there is nothing to detach for. Removing the CFUN
# cycle also removes the main way this dialer used to wedge the modem.
_reg_end=$(( $(date +%s) + 90 ))
while [ "$(date +%s)" -lt "$_reg_end" ]; do
	case "$(at 'AT+CEREG?' 6)" in
		*"+CEREG: 0,1"*|*"+CEREG: 0,5"*|*"+CEREG: 1,1"*|*"+CEREG: 1,5"*) break ;;
		*"+CEREG: 0,3"*)
			warn "network DENIED registration - check the SIM subscription"
			proto_notify_error "$INTERFACE" REGISTRATION_DENIED
			proto_block_restart "$INTERFACE"
			exit 1
			;;
	esac
	sleep 5
done

deactivate_all

AID=""
for attempt in blank table manual; do
	case "$attempt" in
		blank)  [ -n "$APN" ] && continue; try_apn="" ;;
		table)  [ -n "$APN" ] && continue
		        try_apn=$(apn_from_table) || continue
		        log "blank APN did not activate; trying IMSI table entry '$try_apn'" ;;
		manual) [ -n "$APN" ] || continue; try_apn="$APN" ;;
	esac
	for try_type in $(apn_type_ladder); do
		AID=$(activate "$try_apn" "$try_type")
		[ -n "$AID" ] && break
		AID=""
	done
	[ -n "$AID" ] && {
		log "activated apn='${try_apn:-<subscription default>}' type=${try_type} aid=${AID}"
		break
	}
	deactivate_all
done

[ -n "$AID" ] || {
	warn "could not activate a PDP context"
	proto_notify_error "$INTERFACE" NO_BEARER
	exit 1
}

ip=$(ipv4_of "$AID")
[ -n "$ip" ] || {
	warn "activated aid ${AID} but no IPv4 address was granted"
	proto_notify_error "$INTERFACE" NO_ADDRESS
	exit 1
}

# Up at 'bearer': we hold an address. Gating on a data probe would deadlock, because the
# probe needs the route that only publishing installs.
publish "$ip"

while :; do
	sleep "$POLL_INTERVAL" &
	wait $! 2>/dev/null

	if [ "$REPUBLISH" = 1 ]; then
		REPUBLISH=0
		cur=$(ipv4_of "$AID")
		[ -n "$cur" ] && publish "$cur"
		continue
	fi

	cur=$(ipv4_of "$AID")
	if [ -z "$cur" ]; then
		# Two confirmations: one missed poll is far more likely to be AT-port contention
		# than a dropped bearer.
		PDP_DOWN_STREAK=$(( PDP_DOWN_STREAK + 1 ))
		if [ "$PDP_DOWN_STREAK" -ge 2 ]; then
			warn "bearer lost (confirmed); requesting teardown"
			proto_notify_error "$INTERFACE" BEARER_LOST
			exit 1
		fi
		continue
	fi
	PDP_DOWN_STREAK=0

	[ "$cur" != "$LAST_IP" ] && { log "address changed ${LAST_IP} -> ${cur}"; publish "$cur"; continue; }

	# Never ping the .1 pseudo-gateway - it does not answer. Watch the counters instead:
	# tx climbing while rx stays flat is the signature of a context RNDIS is not carrying,
	# so log which aids are active, since more than one is the known cause.
	tx=$(cat "/sys/class/net/${MODEM_NETDEV}/statistics/tx_packets" 2>/dev/null || echo 0)
	rx=$(cat "/sys/class/net/${MODEM_NETDEV}/statistics/rx_packets" 2>/dev/null || echo 0)
	if [ "$tx" -gt "$LAST_TX" ] && [ "$rx" -le "$LAST_RX" ]; then
		BLACKHOLE=$(( BLACKHOLE + 1 ))
		if [ "$BLACKHOLE" -ge 3 ]; then
			warn "tx rising, rx flat for 3 windows - active aids: $(active_aids | tr '\n' ' ')"
			BLACKHOLE=0
		fi
	else
		BLACKHOLE=0
	fi
	LAST_TX="$tx"; LAST_RX="$rx"
done
