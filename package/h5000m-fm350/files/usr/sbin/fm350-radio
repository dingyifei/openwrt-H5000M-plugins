#!/bin/sh
# fm350-radio - apply a band lock or a SIM-slot switch, verify it, and revert if it did not
# work. The only user-initiated AT WRITE path on this device.
#
# ⚠️ WHY THIS IS A PROCD SERVICE AND NOT A BACKGROUNDED SUBSHELL FROM THE WEB BACKEND:
# the whole point is to be running, unattended, at the moment the link is down. A subshell
# spawned by ucode's popen() lives in RPCD'S PROCESS GROUP, and LuCI restarts rpcd on package
# install and on some config applies. A revert timer that dies when rpcd reloads is worse
# than no timer at all, because it looks like protection. procd also gives single-instance
# semantics and survival across the browser tab going away.
#
# ⚠️ WHY THE APPLY PATH OWNS ifdown/ifup:
# changing bands under a live bearer drops the context. The dialer then needs two 30s poll
# misses to declare BEARER_LOST, netifd restarts the proto, and its own 90s registration wait
# races this script's revert decision - the guard reverts mid-bring-up, the dialer loses the
# bearer again, and neither side can see why. Taking the interface down first removes the
# contention entirely and frees the dialer's AT_PRIO=30 claim on the port. Bringing it back up
# reuses the ONE bring-up sequence known to work here (deactivate_all, then the APN-type
# ladder) instead of inventing a second one.
#
# ⚠️ SUCCESS IS DATA, NOT REGISTRATION. Measured after a slot switch: the modem registered
# perfectly while every PDP activation returned +CME ERROR: 5848. A guard that accepted
# "registered" would have called that a success and persisted it.
#
# ⚠️ BAND SETS ARE PER-RAT AND PARTIAL. Manual Note 5, confirmed here: sending LTE bands
# narrows ONLY the LTE list and leaves UMTS and NR untouched. Setting BANDS="103" against
# RAT 20 left `20,6,3,1,2,4,5,8,103,501,...` - LTE pinned to B3 while every NR band stayed
# enabled. So "lock to B3" is not one command: the caller must also choose the RAT, or the
# modem is still free to use 5G. The revert path therefore restores the WHOLE previous
# parameter string rather than just the bands it changed.
#
# No `set -e`: `uci -q get` on an absent key returns non-zero.

ATIO=/usr/lib/h5000m/atio.sh
REQ=/var/run/fm350-radio.req
STATE=/var/run/fm350-radio.state
LOCK=/var/lock/fm350-radio.lock
PENDING=/etc/h5000m/simslot.pending
# The band/RAT string as it was BEFORE a cell lock narrowed it, so unlock can put it back.
#
# ⚠️ THIS MUST OUTLIVE A REBOOT. It used to live in /var/run, justified by the manual's claim
# that AT+GTACT is "Persistent: No" - so a reboot would clear the modem and the record of it
# together. MEASURED FALSE: after a genuine reboot (uptime 28s, nothing in uci) the modem still
# reported the narrowed `+GTACT: 2,3,3,...` AND the cell lock. tmpfs, meanwhile, really is
# cleared. So the two sides came apart: the radio stayed pinned to LTE while the record of what
# it was before was gone, and unlock below silently skipped its restore and reported success -
# stranding the user on LTE with the NR bands stripped, which is the exact failure that restore
# exists to prevent. Persistent state needs persistent storage.
PREVACT=/etc/h5000m/fm350-radio.prevact
IFACE=cellular

# Same tier as SMS and eSIM: user-initiated, must complete. Deliberately NOT above the
# dialer - and in practice it does not contend, because the dialer is stopped for the window.
AT_PRIO=20
export AT_PRIO

# Countdowns in seconds. Never wall-clock deadlines: this board has no RTC and sysntpd steps
# the clock at boot, which would expire a deadline the instant it was computed.
T_REG=45
T_DATA=90
T_ENUM=120

[ -r "$ATIO" ] || { echo "fm350-radio: $ATIO not found" >&2; exit 1; }
# shellcheck disable=SC1090
. "$ATIO"
h5000m_log_init fm350 fm350-radio

say() {
	# The UI polls this file; it is also the cache-generation marker the rpcd backend
	# watches, so every write here makes the web view notice the change.
	printf 'STATE=%s\nDETAIL=%s\n' "$1" "${2:-}" > "$STATE.$$" 2>/dev/null
	mv -f "$STATE.$$" "$STATE" 2>/dev/null
}

at_one() {
	at_state_load 2>/dev/null || return 1
	at_locked "$(at_lockfile "$MODEM_USBPATH" "$MODEM_AT_B_IF")" 20 \
		"$MODEM_AT_B" "$1" "${2:-10}"
}

# L0 - the authority. Free, no AT: the interface is only genuinely usable when netifd says it
# is up AND it has an address.
# ONE ubus call, matched with case. wait_data() polls this every 5s for up to T_DATA=90 and
# runs on every apply and again after every revert, so calling ubus twice and grepping each
# cost ~108 forks and 36 round trips per verify pass where 18 do. `case` is a shell builtin -
# the whole check is now 2 forks.
data_ok() {
	_dk=$(ubus call "network.interface.${IFACE}" status 2>/dev/null)
	case "$_dk" in *'"up": true'*) ;; *) return 1 ;; esac
	case "$_dk" in *'"address"'*)  ;; *) return 1 ;; esac
	return 0
}

wait_registered() {
	_wr_left="$T_REG"
	while [ "$_wr_left" -gt 0 ]; do
		_wr_out=$(at_one 'AT+CEREG?' 8)
		at_reg_ok "$_wr_out" && return 0
		# Denied is terminal - the network refused us, and sitting out the rest of the
		# timeout only delays the revert.
		at_reg_denied "$_wr_out" && { say verifying 'network denied registration'; return 1; }
		_wr_left=$(( _wr_left - 5 ))
		sleep 5
	done
	return 1
}

# The PCI we are ACTUALLY camped on, empty if the modem will not say.
#
# A cell lock binds idle-mode cell SELECTION. Handover, once a bearer is up, is decided by the
# NETWORK, and it may move us straight back off the locked cell. Measured on this unit: with
# the bearer down the modem sat on the locked cell for 90s solid; with the bearer up it held
# ~35s and the network then moved it to a different PCI and kept it there, at comparable RSRP.
# So "registered, and data flows" does NOT mean "camped where you asked".
# ⚠️ `^1,4,` not `^1,`: match the serving row AND require rat=4 (E-UTRAN). Two reasons, both
# real rather than defensive. Under EN-DC the modem reports a serving row PER RAT, so `^1,`
# yields several lines and the comparison below would test a multi-line string against a single
# PCI - never equal, so the guard would announce a handover that never happened. And with
# CELL_LTE_ONLY=0 (a path the user can choose) the modem may camp on NR, whose PCI is a
# different namespace from the E-UTRAN PCI that AT+EMMCHLCK takes; comparing them is meaningless.
# `exit` after the first match keeps it to one row even so.
#
# Field 8 is <physicalcellId> for both the LTE and NR serving layouts (manual §11.1.15), and is
# the same field parse_cell_row() in the rpcd backend reads as f[7] - the two parsers agree, and
# must be changed together if that ever stops being true.
#
# One awk rather than grep|cut|tr: three forks became one, matching this file's stated care about
# fork count on a ~1 GHz MIPS board.
serving_pci() {
	at_one 'AT+GTCCINFO?' 15 2>/dev/null |
		awk -F, '/^1,4,/ { gsub(/[ \r]/, "", $8); print $8; exit }'
}

wait_data() {
	_wd_left="$T_DATA"
	while [ "$_wd_left" -gt 0 ]; do
		data_ok && return 0
		_wd_left=$(( _wd_left - 5 ))
		sleep 5
	done
	return 1
}

# Stop the dialer and wait for it to actually be gone, so nothing else is talking to the port
# while we retune. Bounded: if it will not go, proceed anyway rather than hang forever - the
# priority mechanism still applies, we just lose the guarantee of exclusivity.
iface_down() {
	ifdown "$IFACE" >/dev/null 2>&1
	_id_left=15
	while [ "$_id_left" -gt 0 ]; do
		[ -f "/var/run/fm350-${IFACE}.pid" ] || return 0
		_id_left=$(( _id_left - 1 ))
		sleep 1
	done
	return 0
}

iface_up() { ifup "$IFACE" >/dev/null 2>&1; }

# Wait for the AT endpoint to be genuinely usable again after a re-enumeration. Checks with
# stty, NOT with `ls`: the tty nodes reappear SECONDS BEFORE the endpoint works, and looking
# for the node made two earlier recovery attempts here report success when they had not.
wait_endpoint() {
	_we_left="$T_ENUM"
	while [ "$_we_left" -gt 0 ]; do
		# Never cache a device node across this wait - the modem re-enumerates and the
		# hotplug handler rewrites the state file.
		unset MODEM_AT_B MODEM_AT_B_IF MODEM_USBPATH
		if at_state_load 2>/dev/null && [ -n "$MODEM_AT_B" ]; then
			if stty -F "$MODEM_AT_B" -a 2>/dev/null | grep -q speed; then
				return 0
			fi
		fi
		_we_left=$(( _we_left - 5 ))
		sleep 5
	done
	return 1
}

# ---------------------------------------------------------------- apply: band

# read_gtact - the current +GTACT parameter string, retried past URCs.
#
# Retried because nobody holds the AT port between transactions, so an unsolicited
# +EONSNWNAME/+CIREPI can be the first line back with the +GTACT: line behind it. Reverting to
# a value we misread would be worse than not applying at all.
#
# ⚠️ CAPTURE THIS BEFORE CHANGING THE RAT. Measured: when the RAT is restricted, AT+GTACT?
# reports only the bands of the ACTIVE radio types - selecting RAT 2 (LTE-only) made the reply
# `2,3,3,101,102,...` with the UMTS and NR bands simply absent. A "previous value" captured
# after a RAT change therefore cannot restore them.
read_gtact() {
	_rg_try=3
	while [ "$_rg_try" -gt 0 ]; do
		_rg=$(at_one 'AT+GTACT?' 10 | sed -n 's/^+GTACT: *//p' | head -1)
		[ -n "$_rg" ] && { printf '%s' "$_rg"; return 0; }
		_rg_try=$(( _rg_try - 1 ))
		sleep 2
	done
	return 1
}

# pref_for_rat <rat> - a <PreferredAct> value that is valid for the given RAT.
#
# ⚠️ THE MODEM WILL LEAVE A PREFERENCE FIELD EMPTY BUT WILL NOT ACCEPT ONE. Measured: after a
# cell lock set RAT 2 (LTE-only), the modem silently dropped the carried-forward 6 (NR
# preferred) as invalid for that RAT and stored `+GTACT: 2,,3,...`. Feeding that value straight
# back - which is what carrying the current preferences forward does - produces
# `AT+GTACT=2,,3,...` and `+CME ERROR: phone failure`. So a band lock attempted after a cell
# lock would fail with no obvious cause.
#
# The manual requires the preference to be part of the selected RAT, so pick the best one the
# RAT actually contains: NR if present, else LTE, else UMTS.
pref_for_rat() {
	case "$1" in
		14|16|17|20|10) printf '6' ;;   # includes NR
		2|4)            printf '3' ;;   # includes LTE, no NR
		1)              printf '2' ;;   # UMTS only
		*)              printf '3' ;;   # unknown: LTE is in every multi-RAT mode this radio has
	esac
}

# gtact_replayable <string captured from AT+GTACT?> - the same value, in a form the modem
# will actually ACCEPT back.
#
# ⚠️ A STRING READ FROM THE MODEM IS NOT NECESSARILY REPLAYABLE. The modem happily REPORTS an
# empty preference field but REFUSES to be given one:
#     +GTACT: 14,6,          <- what it reports for NR-only
#     AT+GTACT=14,6,         -> +CME ERROR: phone failure
# Demonstrated the hard way: a restore of exactly that captured value silently did nothing and
# left the radio on the wrong RAT. Every revert path here replays a captured string, so all of
# them were exposed - a revert that cannot restore is the one failure the guard exists to
# prevent.
#
# Fills any empty preference from the string's OWN rat, so the replay means the same thing.
#
# ⚠️ RETRACTION - it is the empty PREFERENCE that is refused, NOT a trailing empty band.
# An earlier version of this comment claimed the original unconditional
#     printf '%s,%s,%s,%s' ... "$rest"
# was a live bug because it turned `14,6,` into `14,6,6,`, and that the trailing empty field
# was "the same defect as a leading empty one". MEASURED, and that is wrong:
#     AT+GTACT=14,6,     rc=2   +CME ERROR: phone failure    <- empty PREFERENCE, refused
#     AT+GTACT=14,,      rc=2   +CME ERROR: phone failure
#     AT+GTACT=14,,6     rc=2   +CME ERROR: phone failure
#     AT+GTACT=14,6,6,   rc=0                                <- empty BAND, ACCEPTED
#     AT+GTACT=14,6,6    rc=0
# So the old code was not broken, and the claim was reasoned rather than tested - the same
# mistake this file documents elsewhere about trusting the manual. What the helper genuinely
# fixes is the empty preference; the band handling below is tidiness, not a repair.
#
# ⚠️ A band-less string is NOT neutral - it ENABLES EVERY BAND of that RAT. Measured:
# `AT+GTACT=2,3,3` read back as `2,3,3,101,102,...,166`, the full LTE set. That is the right
# restore here only because a CAPTURED string with no band list already meant "all bands".
# Never use the band-less form to mean "leave the bands alone".
#
# Parameter expansion rather than `cut`: four forks became zero, on a path the rest of this
# file is careful about.
gtact_replayable() {
	_gr_bands=$(gtact_bands "$1")
	gtact_join "${1%%,*}" "$(gtact_prefs "$1" "${1%%,*}")" "$_gr_bands"
}

# --- the three pieces of "build a valid AT+GTACT= string", each with exactly one owner ------
#
# These exist because the SAME two rules were open-coded in three places (apply_band, apply_cell
# and gtact_replayable) and each copy got a different subset of them right. apply_band appended
# bands conditionally but the other two did not; gtact_replayable filled empty preferences from
# the string's own RAT but apply_cell hard-codes 2. The result was the identical trailing-comma
# defect shipped twice, in a helper whose whole purpose was to prevent it. One owner per rule.

# gtact_prefs <gtact string> <rat to fall back on> -> "<p1>,<p2>", empties filled.
# Callers differ ONLY in the fallback RAT, which is why that is the parameter: a replay uses the
# string's own RAT, a band apply the requested one, a cell apply the LTE-only 2 it is moving to.
gtact_prefs() {
	_gp_s=${1#*,}
	_gp_p1=${_gp_s%%,*}
	_gp_s=${_gp_s#*,}
	_gp_p2=${_gp_s%%,*}
	[ -n "$_gp_p1" ] || _gp_p1=$(pref_for_rat "$2")
	[ -n "$_gp_p2" ] || _gp_p2=$(pref_for_rat "$2")
	printf '%s,%s' "$_gp_p1" "$_gp_p2"
}

# gtact_bands <gtact string> -> the comma-separated band list, or empty when there is none.
# `${s#*,}` cannot express "everything after field 3" when field 3 is the last field, so the
# absence of a further separator is what distinguishes "no bands" from "bands".
gtact_bands() {
	_gb_s=${1#*,}; _gb_s=${_gb_s#*,}
	case "$_gb_s" in
		*,*) printf '%s' "${_gb_s#*,}" ;;
		*)   printf '' ;;
	esac
}

# gtact_join <rat> <"p1,p2"> <bands or empty> -> the set string.
# The band list is appended only when non-empty. NOT because a trailing comma is refused - it
# is accepted, measured - but because `14,6,6` is what the modem itself reports and there is no
# reason to hand back a form it never produced.
gtact_join() {
	if [ -n "$3" ]; then
		printf '%s,%s,%s' "$1" "$2" "$3"
	else
		printf '%s,%s' "$1" "$2"
	fi
}

apply_band() {
	_ab_prev=$(read_gtact)
	# Without this an unread previous value would build `AT+GTACT=<rat>,,` - malformed, and
	# with nothing to revert to afterwards.
	[ -n "$_ab_prev" ] || { say failed 'could not read the current band configuration'; return 1; }

	# ⚠️ FIELDS 2 AND 3 ARE PreferredAct1/PreferredAct2, NOT BANDS. The set form is
	#     AT+GTACT=<rat>,<pref1>,<pref2>[,<band>...]
	# and sending `AT+GTACT=20,103` puts a band number where only 2/3/6 are accepted - the
	# modem answers +CME ERROR and nothing changes. Measured here.
	#
	# The empty-field form the manual's brackets imply, `AT+GTACT=20,,,103`, is ALSO
	# rejected on this firmware ("+CME ERROR: phone failure"), so the preferences cannot be
	# omitted either. Carry forward whatever the modem currently reports.
	# An empty carried-forward preference is rejected on the way back in - see pref_for_rat.
	_ab_bands=''
	for _b in $BANDS; do _ab_bands="${_ab_bands:+${_ab_bands},}${_b}"; done
	_ab_new=$(gtact_join "$RAT" "$(gtact_prefs "$_ab_prev" "$RAT")" "$_ab_bands")

	say applying "AT+GTACT=${_ab_new}"
	log_info 'applying band configuration %s (previous %s)' "$_ab_new" "$_ab_prev"

	iface_down
	if ! at_one "AT+GTACT=${_ab_new}" 15 >/dev/null; then
		say failed 'the modem rejected the band configuration'
		log_warn '%s' 'modem rejected AT+GTACT; nothing was changed'
		iface_up
		return 1
	fi

	say verifying 'waiting for the modem to register'
	if wait_registered; then
		iface_up
		say verifying 'waiting for a data bearer'
		if wait_data; then
			say ok "band configuration ${_ab_new} active"
			log_info 'band configuration %s verified' "$_ab_new"
			# ⛔ There used to be a `PERSIST=1` branch here writing
			# network.<iface>.rat/.bands to uci. It was removed because it was
			# doing nothing twice over. Nothing ever READ those options - not this
			# script, not fm350-dialer, not /lib/netifd/proto/fm350.sh - and the
			# setting persists anyway: measured after a genuine reboot with uci
			# empty, the modem still reported the narrowed +GTACT. So the flag made
			# no difference in either position while implying a choice existed.
			return 0
		fi
	fi

	# Revert to the exact string read before the change, not to "automatic": the previous
	# setting may itself have been a deliberate lock.
	log_warn 'band configuration %s did not carry data; reverting to %s' "$_ab_new" "$_ab_prev"
	say reverting "restoring ${_ab_prev}"
	iface_down
	at_one "AT+GTACT=$(gtact_replayable "$_ab_prev")" 15 >/dev/null
	iface_up
	say reverted "reverted to the previous band configuration"
	return 1
}

# ---------------------------------------------------------------- apply: cell
#
# AT+EMMCHLCK pins the modem to one E-UTRAN cell. Verified on this firmware:
#
#   AT+EMMCHLCK=?  ->  +EMMCHLCK: (0-1),(0,2,7),(0,1),(0-46589),(0-511)
#                          enable  rat    ?      earfcn      pci
#
# It is ABSENT from AT+CLAC, which lists 37 commands and misses this one - the third time in
# this project that CLAC has under-reported. CLAC finding a command proves presence; CLAC
# missing one proves nothing.
#
# ⚠️ Three things that make this harder than it looks, all measured:
#
#  1. RAT accepts only (0,2,7) - GSM/UTRAN/E-UTRAN. There is NO NR cell locking on this
#     firmware. The six-parameter NR form circulating online (=1,11,0,<nr-arfcn>,<pci>,3) is
#     from a different variant and is rejected here: 11 is not in the RAT set and an NR-ARFCN
#     exceeds the 46589 ceiling.
#  2. The lock is accepted WITHOUT a CFUN cycle and AT+EMMCHLCK? immediately reports it - so
#     it looks applied - but the modem does not reselect. Locked to a visible neighbour with
#     no CFUN cycle it sat on its original cell for the full 30s observed. The lock constrains
#     FUTURE selection only, so forcing reselection needs CFUN=0/CFUN=1.
#  3. A cell lock does NOT stop the modem using 5G. With an LTE cell locked and the radio
#     cycled, it camped on NR instead. EMMCHLCK constrains E-UTRAN selection and nothing else,
#     which is why CELL_LTE_ONLY exists.
#
# The read form returns SIX fields where the set form takes five, so a value read back cannot
# be replayed verbatim - see emmchlck_restore().

# emmchlck_restore <previous +EMMCHLCK value> - replay a captured lock state.
emmchlck_restore() {
	case "${1:-0}" in
		0|'') at_one 'AT+EMMCHLCK=0' 20 >/dev/null ;;
		# The read form has a trailing sixth field the set form does not accept; take five.
		*)    at_one "AT+EMMCHLCK=$(printf '%s' "$1" | cut -d, -f1-5)" 20 >/dev/null ;;
	esac
}

apply_cell() {
	_ac_prev_cell=$(at_one 'AT+EMMCHLCK?' 10 | sed -n 's/^+EMMCHLCK: *//p' | head -1)
	[ -n "$_ac_prev_cell" ] || _ac_prev_cell=0

	# An empty ARFCN means unlock. Handled BEFORE reading the band configuration: unlock
	# restores from $PREVACT and never looks at the current value, so reading it here would
	# spend up to three AT+GTACT? retries on the shared port and - worse - could refuse to
	# unlock with "could not read the current band configuration" over a value it discards.
	# Refusing to UNLOCK is the one failure this path must not have.
	if [ -z "${CELL_ARFCN:-}" ]; then
		say applying 'clearing the cell lock'
		iface_down
		at_one 'AT+CFUN=0' 20 >/dev/null
		sleep 2
		at_one 'AT+EMMCHLCK=0' 20 >/dev/null
		sleep 2
		# Undo the RAT narrowing the lock applied, if any. Without this, clearing a cell lock
		# that was taken with CELL_LTE_ONLY leaves the radio silently pinned to LTE with the
		# UMTS and NR bands still stripped - the user asked to unlock a cell and quietly lost
		# 5G. Measured exactly that before this existed.
		if [ -r "$PREVACT" ]; then
			at_one "AT+GTACT=$(gtact_replayable "$(cat "$PREVACT")")" 20 >/dev/null
			rm -f "$PREVACT"
			sleep 1
		fi
		at_one 'AT+CFUN=1' 20 >/dev/null
		iface_up
		say verifying 'waiting for a data bearer'
		if wait_data; then
			say ok 'cell lock cleared'
			return 0
		fi
		say failed 'cell lock cleared but no data bearer came back'
		return 1
	fi

	# Captured BEFORE any RAT change, for the reason in read_gtact(). Only the lock path
	# needs it, which is why it sits below the unlock branch.
	_ac_prev_act=$(read_gtact)
	[ -n "$_ac_prev_act" ] || { say failed 'could not read the current band configuration'; return 1; }

	say applying "AT+EMMCHLCK=1,7,0,${CELL_ARFCN},${CELL_PCI}"
	log_info 'locking to earfcn %s pci %s (lte_only=%s)' \
		"$CELL_ARFCN" "$CELL_PCI" "${CELL_LTE_ONLY:-0}"

	iface_down
	at_one 'AT+CFUN=0' 20 >/dev/null
	sleep 2

	if ! at_one "AT+EMMCHLCK=1,7,0,${CELL_ARFCN},${CELL_PCI}" 20 >/dev/null; then
		say failed 'the modem rejected the cell lock'
		at_one 'AT+CFUN=1' 20 >/dev/null
		iface_up
		return 1
	fi

	# Optional, and the reason this is worth doing at all: without it the modem is free to
	# camp on NR and ignore the lock entirely. The FULL previous band list is passed through
	# so narrowing the RAT does not silently discard a band lock set earlier.
	if [ "${CELL_LTE_ONLY:-0}" = 1 ]; then
		# The modem drops an NR preference under an LTE-only RAT and then refuses to take the
		# empty field back, so substitute one valid for RAT 2 rather than pass it on. Built
		# through the shared helpers: the hand-rolled version here appended the band list
		# unconditionally and so emitted `AT+GTACT=2,3,3,` - rejected - whenever the previous
		# string carried no bands.
		#
		# The restore record is written FIRST and its success CHECKED, because everything after
		# this narrows the radio. Losing the record while still narrowing is the one ordering
		# that strands the user on LTE with no way back, which is the failure this whole path
		# exists to prevent. mkdir -p mirrors what apply_slot already does for its own record.
		if [ ! -e "$PREVACT" ]; then
			mkdir -p "${PREVACT%/*}" 2>/dev/null
			# Written only if absent, so re-locking does not overwrite the ORIGINAL pre-lock
			# value with an already-narrowed one and strand the user on LTE forever.
			if ! printf '%s' "$_ac_prev_act" > "$PREVACT" 2>/dev/null; then
				say failed 'could not save the pre-lock radio configuration; refusing to restrict to LTE'
				log_warn 'cannot write %s; not narrowing the RAT' "$PREVACT"
				at_one 'AT+CFUN=1' 20 >/dev/null
				iface_up
				return 1
			fi
		fi
		at_one "AT+GTACT=$(gtact_join 2 "$(gtact_prefs "$_ac_prev_act" 2)" "$(gtact_bands "$_ac_prev_act")")" 20 >/dev/null
	fi

	at_one 'AT+CFUN=1' 20 >/dev/null
	say verifying 'waiting for the modem to register on the locked cell'

	if wait_registered; then
		iface_up
		say verifying 'waiting for a data bearer'
		if wait_data; then
			# Report where we ACTUALLY are, not merely that the write was accepted. The
			# lock can be perfectly applied and the network still steer us elsewhere; a
			# flat "locked to X" would then be a success message for a state the user
			# does not have, and the Cells page showing a different serving cell would
			# read as a bug in us rather than as the operator's decision.
			_ac_at=$(serving_pci)
			if [ -n "$_ac_at" ] && [ "$_ac_at" != "$CELL_PCI" ]; then
				say ok "lock set on earfcn ${CELL_ARFCN} pci ${CELL_PCI}, but the network moved us to pci ${_ac_at}"
				log_info 'cell lock set (earfcn %s pci %s); serving cell is pci %s - network handover, not a failure' \
					"$CELL_ARFCN" "$CELL_PCI" "$_ac_at"
			else
				say ok "locked to earfcn ${CELL_ARFCN} pci ${CELL_PCI}"
				log_info 'cell lock verified: earfcn %s pci %s' "$CELL_ARFCN" "$CELL_PCI"
			fi
			return 0
		fi
	fi

	log_warn 'cell earfcn %s pci %s did not carry data; reverting' "$CELL_ARFCN" "$CELL_PCI"
	say reverting 'restoring the previous cell lock and band configuration'
	iface_down
	at_one 'AT+CFUN=0' 20 >/dev/null
	sleep 2
	emmchlck_restore "$_ac_prev_cell"
	sleep 1
	# Restore the band/RAT string unconditionally: even when CELL_LTE_ONLY was 0 this is a
	# no-op, and getting it wrong the other way would leave the radio narrowed to LTE.
	at_one "AT+GTACT=$(gtact_replayable "$_ac_prev_act")" 20 >/dev/null
	rm -f "$PREVACT"
	at_one 'AT+CFUN=1' 20 >/dev/null
	iface_up
	say reverted 'reverted to the previous cell and band configuration'
	return 1
}

# ---------------------------------------------------------------- apply: slot

apply_slot() {
	_as_cur=$(at_one 'AT+GTDUALSIM?' 10 | sed -n 's/.*+GTDUALSIM *: *\([0-9]*\).*/\1/p' | head -1)
	[ -n "$_as_cur" ] || { say failed 'could not read the current SIM slot'; return 1; }
	if [ "$_as_cur" = "$SLOT" ]; then
		say ok "already on SIM slot $SLOT"
		return 0
	fi

	# The rollback record is written BEFORE anything is touched, and it is the one piece of
	# state that must survive a reboot: AT+GTDUALSIM is persistent in firmware, and the
	# failure modes here include the AT endpoint going deaf.
	mkdir -p /etc/h5000m
	printf 'PREV=%s\nTARGET=%s\nBOOTS=0\n' "$_as_cur" "$SLOT" > "$PENDING"

	say applying "switching to SIM slot $SLOT"
	log_warn 'switching SIM slot %s -> %s (this breaks the bearer; recovery is documented)' \
		"$_as_cur" "$SLOT"

	iface_down
	at_one "AT+GTDUALSIM=${SLOT}" 20 >/dev/null

	say verifying 'waiting for the modem to re-enumerate'
	if ! wait_endpoint; then
		# The measured worst case: the AT endpoint goes half-dead. The USB authorized
		# toggle is the only thing that recovers it, and it is worth doing unprompted -
		# the alternative is a modem nobody can talk to.
		log_warn '%s' 'AT endpoint did not return; running a USB reset'
		say verifying 'AT endpoint wedged - resetting USB'
		/usr/sbin/fm350-usb-reset --wait >/dev/null 2>&1
		wait_endpoint || { say failed 'the AT endpoint did not come back'; iface_up; return 1; }
	fi

	# EMPTY_EUICC is a TERMINAL SUCCESS, not a failure: switching to the eSIM is exactly
	# what you do before provisioning it, and auto-reverting would make provisioning
	# impossible. Report it and stop, rather than treating "no data" as a failed switch.
	case "$(at_one 'AT+CPIN?' 10)" in
		*EMPTY_EUICC*)
			say ok "on SIM slot $SLOT - eUICC present with no profile installed"
			log_warn '%s' 'switched to the eUICC; it has no profile, so cellular stays down'
			rm -f "$PENDING"
			iface_up
			return 0
			;;
	esac

	iface_up
	say verifying 'waiting for a data bearer'
	if wait_data; then
		# Deliberately NOT auto-confirmed, unlike a band lock. "Data flows" fully proves a
		# band change, but on a different SIM the data may be flowing on the wrong account
		# at roaming rates - that needs a human to say yes.
		say confirm "SIM slot $SLOT is carrying data - confirm to keep it"
		return 0
	fi

	log_warn 'SIM slot %s did not carry data; reverting to %s' "$SLOT" "$_as_cur"
	say reverting "restoring SIM slot $_as_cur"
	iface_down
	at_one "AT+GTDUALSIM=${_as_cur}" 20 >/dev/null
	wait_endpoint
	rm -f "$PENDING"
	iface_up
	say reverted "reverted to SIM slot $_as_cur"
	return 1
}

# ---------------------------------------------------------------- entry points

do_run() {
	# -n rather than a wait: a second apply queued behind the first would act on state the
	# first one is still changing.
	flock -n -x 9 2>/dev/null || { echo "fm350-radio: already running" >&2; exit 3; }

	[ -r "$REQ" ] || { echo "fm350-radio: no request" >&2; exit 2; }

	# Claim the state file IMMEDIATELY, before the first AT read. Otherwise a caller that
	# starts us and then polls sees the PREVIOUS run's terminal state (`ok`, `reverted`) and
	# concludes this run already finished - which is exactly what a web UI does.
	say applying 'starting'

	# shellcheck disable=SC1090
	. "$REQ"

	# Installed FIRST, before anything can fail: the worst outcome of a killed guard must be
	# "settings unchanged, interface back up", never "interface administratively down".
	trap 'ifup "$IFACE" >/dev/null 2>&1; rm -f "$REQ"; exit 1' INT TERM HUP

	case "${ACTION:-}" in
		band) apply_band ;;
		cell) apply_cell ;;
		slot) apply_slot ;;
		*) say failed "unknown action '${ACTION:-}'"; rm -f "$REQ"; exit 2 ;;
	esac
	_rc=$?

	trap - INT TERM HUP
	rm -f "$REQ"
	return "$_rc"
}

# Boot-time rollback for a slot switch nobody confirmed. >=2 rather than >=1 so a deliberate
# reboot inside a healthy confirmation window does not undo a good switch.
do_boot_check() {
	[ -r "$PENDING" ] || return 0
	# shellcheck disable=SC1090
	. "$PENDING"
	_bc=$(( ${BOOTS:-0} + 1 ))
	if [ "$_bc" -ge 2 ]; then
		log_error 'SIM slot switch to %s was never confirmed across %s boots; restoring %s' \
			"$TARGET" "$_bc" "$PREV"
		at_one "AT+GTDUALSIM=${PREV}" 20 >/dev/null
		rm -f "$PENDING"
	else
		printf 'PREV=%s\nTARGET=%s\nBOOTS=%s\n' "$PREV" "$TARGET" "$_bc" > "$PENDING"
	fi
	return 0
}

case "${1:-}" in
	run)
		mkdir -p /var/lock
		( do_run ) 9>"$LOCK"
		exit $?
		;;
	boot-check)
		do_boot_check
		;;
	confirm)
		rm -f "$PENDING"
		say ok 'confirmed'
		;;
	*)
		cat <<'EOF'
usage: fm350-radio run | confirm | boot-check

Reads its request from /var/run/fm350-radio.req:
  ACTION=band  RAT=<n>  BANDS="<n> <n> ..."
  ACTION=cell  CELL_ARFCN=<n>  CELL_PCI=<n>  CELL_LTE_ONLY=0|1
               (an empty CELL_ARFCN clears the lock)
  ACTION=slot  SLOT=0|1

There is no PERSIST option: the modem keeps its own band/RAT selection and cell lock
across a reboot whatever we do, so there is nothing to opt into. Use the unlock form
(empty CELL_ARFCN) to undo a cell lock - a reboot will not.

Progress is written to /var/run/fm350-radio.state.
EOF
		exit 2
		;;
esac
