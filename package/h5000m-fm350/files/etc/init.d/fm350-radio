#!/bin/sh /etc/rc.common
# procd wrapper for the band/slot apply-verify-revert guard.
#
# The service exists so the guard survives things that would kill a backgrounded child of the
# web backend - chiefly `/etc/init.d/rpcd restart`, which LuCI triggers on package install and
# which would otherwise SIGTERM the process group holding the revert timer.
#
# START is late: nothing here should run before the network stack and the modem hotplug have
# had a chance to settle. STOP is early so a shutdown does not interrupt a live apply window
# any later than it must.

START=95
STOP=10

USE_PROCD=1
PROG=/usr/sbin/fm350-radio

start_service() {
	# The request is a FILE rather than argv because `/etc/init.d/fm350-radio start` passes
	# no arguments through, and a procd instance's command line is fixed at the moment
	# start_service runs. The caller writes /var/run/fm350-radio.req, then starts us.
	[ -r /var/run/fm350-radio.req ] || return 0

	procd_open_instance radio
	procd_set_param command "$PROG" run
	# Deliberately NOT respawned. If the guard dies, its trap has already brought the
	# interface back up; restarting it would re-apply a change that just failed and could
	# loop indefinitely on hardware that cannot do what was asked.
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

boot() {
	# Only the rollback check at boot - never an apply. A pending, unconfirmed SIM-slot
	# switch is the one thing that must be undone without anyone asking, because
	# AT+GTDUALSIM is persistent in firmware and an unreachable modem cannot be fixed
	# from the web UI it just took away.
	"$PROG" boot-check >/dev/null 2>&1
	return 0
}

stop_service() {
	return 0
}
