#!/usr/bin/ucode
// rpcd backend for luci-app-fm350: FM350 status, SMS and recovery actions.
//
// LOCATION MATTERS: this belongs in /usr/share/rpcd/ucode/, NOT /usr/libexec/rpcd/. The
// latter is rpcd's *exec* plugin protocol - it forks the file with list/call argv and
// parses stdout - and every file there in luci master is a /bin/sh script. ucode scripts
// are loaded into a VM instead, and must return { '<ubus object>': methods } at top level.
//
// PORT DISCIPLINE: this NEVER opens a serial device. Every AT exchange goes through `atq`
// and every SMS through `h5000m-sms`, both of which take the shared lock keyed on the
// stable USB topology path. A page that opened the port directly would desynchronise the
// dialer - the exact reason QModem was rejected for this device.
//
// PRIORITY: AT_PRIO=1, the lowest tier. A status page refreshing itself must never delay
// the dialer keeping the link up, and ATQ_WAIT is short so contention surfaces as
// "modem busy" rather than a page that hangs for half a minute.

'use strict';

import { popen, readfile, stat, writefile, rename } from 'fs';
import { connect } from 'ubus';

const IFACE = 'cellular';
const ATQ_PRIO = 'AT_PRIO=1 ATQ_WAIT=3';

// Written by the band/slot guard when it changes radio state; used only as a generation
// marker so this VM notices changes made by that other process.
const GUARD_STATE = '/var/run/fm350-radio.state';
// Produced by the detached cell collector. AT+GTCCINFO? is documented <3s and rpcd is
// SINGLE-THREADED, so calling it inline would freeze every LuCI page for the duration.
const CELLS_FILE = '/var/run/fm350-cells.json';
// Persistent, overlay-backed SMS archive written by h5000m-sms-archive. Read here to merge
// archived messages into the inbox; missing/unparseable is treated as "no archive" and never
// surfaced as an error, matching how a missing modem binary already degrades on this backend.
const SMS_ARCHIVE = '/etc/h5000m/sms-archive.json';

// Concatenated-SMS grouping lives in h5000m-modem-atd (a HARD dependency of this app) so both
// this backend and the archive worker share one implementation. loadfile() runs the module and
// returns its exports; a missing file would throw, which is acceptable and by design - the
// module is in a hard-dep package precisely so it is always present. See the module header.
const grouping = loadfile('/usr/share/ucode/h5000m/sms_grouping.uc')();

// Cached across calls because rpcd keeps the VM loaded: N browser tabs then cost ONE AT
// transaction per interval instead of N. Without this, two open tabs in live mode would
// double the load on the scarcest resource on the device.
//
// Keyed cache: one slot per read-group, each with its own TTL.
//
// A single slot cannot serve reads whose costs differ by 10x, and the reason is subtler than
// "different refresh rates": at_locked_batch applies ONE timeout to EVERY command in a batch,
// and at_exec wraps each in timeout(tmo+2). Batching the cheap +CESQ with the documented-<3s
// AT+GTCCINFO? therefore drags the whole batch to a 6s timeout and lengthens the worst-case
// LOCK HOLD for everything in it - on the single AT port the dialer also needs. Cost, not
// cadence, is what draws the group boundaries below.
let cache = {};

// Bumped when the band/slot guard changes radio state from another process. That process
// cannot reach this VM's memory, so volatile entries additionally compare a generation marker
// - the mtime of the guard's state file - and miss when it has moved.
function cache_gen() {
	const st = stat(GUARD_STATE);
	return st ? st.mtime : 0;
}

// producer() is only called on a miss. `volatile` marks entries that another process can
// invalidate; static ones (model, capabilities) skip the stat() entirely.
function cached(key, ttl, volatile, producer) {
	const now = time();
	const gen = volatile ? cache_gen() : 0;
	const e = cache[key];
	if (e && (now - e.at) < ttl && e.gen == gen)
		return { data: e.data, age: now - e.at, cached: true };
	const data = producer();
	cache[key] = { at: now, gen: gen, data: data };
	return { data: data, age: 0, cached: false };
}

function cache_drop(key) {
	delete cache[key];
}

function shq(s) {
	return "'" + replace(s ?? '', "'", "'\\''") + "'";
}

function run(cmd) {
	const fd = popen(cmd, 'r');
	if (!fd)
		return null;
	const out = fd.read('all');
	fd.close();
	return out;
}

// Parse the @@CMD / body / @@RC stream that `atq -b` emits. Returning a map keyed by
// command lets callers ask for what they want without caring about ordering.
function atq_batch(cmds) {
	let args = '';
	for (let c in cmds)
		args += ' ' + shq(c);

	const out = run(`${ATQ_PRIO} /usr/sbin/atq -b${args} 2>/dev/null`);
	const res = {};
	if (!out)
		return res;

	let cur = null;
	for (let line in split(out, '\n')) {
		if (substr(line, 0, 6) == '@@CMD ') {
			cur = substr(line, 6);
			res[cur] = { lines: [], rc: -1 };
		}
		else if (substr(line, 0, 5) == '@@RC ') {
			if (cur != null)
				res[cur].rc = +substr(line, 5);
			cur = null;
		}
		else if (cur != null && trim(line) != '') {
			push(res[cur].lines, trim(line));
		}
	}
	return res;
}

function first_line(res, cmd, prefix) {
	const e = res?.[cmd];
	if (!e || e.rc != 0)
		return null;
	for (let l in e.lines)
		if (index(l, prefix) == 0)
			return l;
	return null;
}

// +CESQ fields, per 3GPP TS 27.007:
//   0 rxlev  1 ber  2 rscp  3 ecno  4 rsrq  5 rsrp  6 ssrsrp  7 ssrsrq  8 sssinr
//
// WHICH FIELDS ARE LIVE DEPENDS ON THE RADIO ACCESS TECHNOLOGY, and 255 means "not
// available". Both shapes were observed on this unit within a day:
//   NR : +CESQ: 99,99,255,255,255,255,83,73,77    <- the NR triple
//   LTE: +CESQ: 27,99,255,255,16,44,255,255,255   <- the LTE pair
// A page hard-coded to one of them shows nonsense on the other, so decide from the value
// rather than assuming, and report unavailable as null so the view can print a dash.
function parse_cesq(line) {
	if (!line)
		return {};
	const f = split(replace(line, /^\+CESQ:\s*/, ''), ',');
	const v = [];
	for (let x in f)
		push(v, +trim(x));

	const out = {};
	// NR first: when the modem is on 5G the LTE pair is 255 and vice versa, so whichever
	// set is populated is the one that describes the current serving cell.
	if (length(v) > 8 && v[6] != 255) {
		out.rat_hint = 'NR';
		out.rsrp = v[6] - 156;
		out.rsrq = (v[7] / 2) - 43;
		out.sinr = (v[8] / 2) - 23;
	}
	else if (length(v) > 5 && v[5] != 255) {
		out.rat_hint = 'LTE';
		out.rsrp = v[5] - 140;
		out.rsrq = (v[4] / 2) - 19.5;
	}
	return out;
}

// AT+COPS? -> +COPS: <mode>,<format>,"<oper>",<AcT>
// AcT values seen here: 7 = E-UTRAN (LTE), 11 = NR connected to a 5G core.
// A function rather than an object literal: ucode rejects bare numeric keys ("Expecting
// label"), and quoting them would then need the lookup to coerce int->string.
function act_name(a) {
	switch (a) {
	case 0:  return 'GSM';
	case 2:  return 'UTRAN';
	case 3:  return 'GSM/EGPRS';
	case 4:  return 'UTRAN/HSDPA';
	case 5:  return 'UTRAN/HSUPA';
	case 6:  return 'UTRAN/HSPA';
	case 7:  return 'LTE';
	case 11: return 'NR (5GC)';
	case 12: return 'NG-RAN';
	case 13: return 'LTE/NR';
	default: return `AcT ${a}`;
	}
}

function parse_cops(line) {
	if (!line)
		return {};
	// No non-capturing group here: ucode's regex engine rejects (?:...) with "Repetition
	// not preceded by valid expression". The AcT field is captured as a possibly-empty
	// run of digits instead, which costs nothing and works.
	const m = match(line, /\+COPS:\s*\d+,\s*\d+,\s*"([^"]*)",?\s*([0-9]*)/);
	if (!m)
		return {};
	const act = (m[2] != null && m[2] != '') ? +m[2] : null;
	return {
		operator: m[1],
		act: act,
		act_name: act != null ? act_name(act) : null
	};
}

function reg_name(r) {
	switch (r) {
	case 0:  return 'not registered';
	case 1:  return 'registered (home)';
	case 2:  return 'searching';
	case 3:  return 'denied';
	case 4:  return 'unknown';
	case 5:  return 'registered (roaming)';
	default: return `state ${r}`;
	}
}

function parse_cereg(line) {
	const m = line ? match(line, /\+CEREG:\s*\d+,\s*(\d+)/) : null;
	if (!m)
		return {};
	return { reg: +m[1], reg_name: reg_name(+m[1]) };
}

function active_aid(res) {
	const e = res?.['AT+CGACT?'];
	if (!e || e.rc != 0)
		return null;
	for (let l in e.lines) {
		const m = match(l, /\+CGACT:\s*(\d+),\s*1/);
		if (m)
			return +m[1];
	}
	return null;
}

// Interface state comes from ubus and sysfs, never AT: it is free, always current, and
// costs no share of the single serial port.
function iface_state() {
	const out = { up: false, device: null, ipv4: null, gateway: null, dns: [] };
	try {
		const bus = connect();
		const st = bus.call(`network.interface.${IFACE}`, 'status');
		bus.disconnect();
		if (!st)
			return out;
		out.up = st.up ?? false;
		out.device = st.l3_device;
		out.dns = st['dns-server'] ?? [];
		const a = st['ipv4-address']?.[0];
		if (a)
			out.ipv4 = `${a.address}/${a.mask}`;
		for (let r in (st.route ?? []))
			if (r.target == '0.0.0.0' && r.mask == 0)
				out.gateway = r.nexthop;
	} catch (e) { }
	return out;
}

function counters(dev) {
	if (!dev)
		return {};
	const rx = readfile(`/sys/class/net/${dev}/statistics/rx_packets`);
	const tx = readfile(`/sys/class/net/${dev}/statistics/tx_packets`);
	return { rx_packets: rx ? +trim(rx) : null, tx_packets: tx ? +trim(tx) : null };
}

function collect_status() {
	const res = atq_batch([
		'AT+CESQ', 'AT+COPS?', 'AT+CEREG?', 'AT+CGACT?', 'AT+CGMM'
	]);

	// Every AT command failing means the port is held or the modem is away. Say so
	// explicitly rather than rendering a page full of blanks that looks like "no signal".
	let ok = false;
	for (let k in res)
		if (res[k].rc == 0)
			ok = true;

	const st = iface_state();
	const aid = active_aid(res);

	let apn = null, dns = [];
	if (aid != null) {
		const rdp = atq_batch([`AT+CGCONTRDP=${aid}`]);
		const l = first_line(rdp, `AT+CGCONTRDP=${aid}`, '+CGCONTRDP:');
		if (l) {
			const f = split(l, ',');
			if (length(f) > 2)
				apn = replace(trim(f[2]), /"/g, '');
			for (let i = 5; i < 7 && i < length(f); i++) {
				const d = replace(trim(f[i]), /"/g, '');
				// CGCONTRDP renders IPv6 as sixteen dotted octets; keep the four-octet
				// form so a v6 address is not shown as though it were v4.
				if (d != '' && length(split(d, '.')) == 4)
					push(dns, d);
			}
		}
	}

	return {
		modem_reachable: ok,
		model: first_line(res, 'AT+CGMM', '') ,
		...parse_cesq(first_line(res, 'AT+CESQ', '+CESQ:')),
		...parse_cops(first_line(res, 'AT+COPS?', '+COPS')),
		...parse_cereg(first_line(res, 'AT+CEREG?', '+CEREG:')),
		aid: aid,
		apn: apn,
		dns: length(dns) ? dns : st.dns,
		interface: st,
		...counters(st.device)
	};
}

// --- band encoding -------------------------------------------------------------------
//
// +GTACT numbers bands as a flat integer list, NOT a bitmask (that is +EPBSEH). Verified
// against this modem's own AT+GTACT=? on 2026-07-28:
//   UMTS  1..8        -> B I..VIII
//   LTE   100 + N     -> 101 = B1  ... 166 = B66, 171 = B71
//   NR    "50" .. N   -> 501 = n1 ... 509 = n9, then 5020 = n20 ... 50512 = n512
// The NR form is literal digit concatenation, which is why it is not simply 500+N.
function band_label(v) {
	if (v >= 500)
		return `n${substr('' + v, 2)}`;
	if (v >= 100)
		return `B${v - 100}`;
	return `U${v}`;
}

function band_group(v) {
	if (v >= 500) return 'nr';
	if (v >= 100) return 'lte';
	return 'umts';
}

// Split "(a,b,c)" groups out of a +GTACT=? reply. ucode has no (?:...) so this walks the
// string rather than trying to express nesting in one regex.
function paren_groups(s) {
	const out = [];
	let cur = null;
	for (let i = 0; i < length(s); i++) {
		const c = substr(s, i, 1);
		if (c == '(') { cur = ''; continue; }
		if (c == ')') { if (cur != null) push(out, cur); cur = null; continue; }
		if (cur != null) cur += c;
	}
	return out;
}

function int_list(s) {
	const out = [];
	for (let p in split(s ?? '', ',')) {
		const t = trim(p);
		if (t != '' && match(t, /^[0-9]+$/))
			push(out, +t);
	}
	return out;
}

// AT+GTACT=? -> (rat),(pref1),(pref2),(gsm),(umts),(lte),(cdma),(evdo),(nr)
// GSM/CDMA/EV-DO come back empty on this radio; the picker must be built from THIS, not from
// a hard-coded B1..B71 range, or it would offer bands the hardware does not have.
function parse_gtact_caps(line) {
	if (!line)
		return null;
	const g = paren_groups(line);
	if (length(g) < 9)
		return null;
	return {
		rats: int_list(g[0]),
		umts: int_list(g[4]),
		lte:  int_list(g[5]),
		nr:   int_list(g[8])
	};
}

// +GTACT <rat> values, manual §11.1.14. A switch, not an object literal - ucode rejects bare
// numeric keys. This is the modem's own enumeration, so it is decoded rather than shown raw;
// the modulation codes in +GTCAINFO are deliberately NOT decoded, because no authoritative
// code->QAM mapping exists for this modem and a wrong "256QAM" is worse than an integer.
function gtact_rat_name(r) {
	switch (r) {
	case 1:  return 'UMTS';
	case 2:  return 'LTE';
	case 4:  return 'LTE/UMTS';
	case 10: return 'automatic';
	case 14: return 'NR';
	case 16: return 'NR/UMTS';
	case 17: return 'NR/LTE';
	case 20: return 'NR/LTE/UMTS';
	default: return `mode ${r}`;
	}
}

// <PreferredAct1>/<PreferredAct2>: which RAT the modem should favour, same section.
function gtact_pref_name(p) {
	switch (p) {
	case 2: return 'UMTS';
	case 3: return 'LTE';
	case 6: return 'NR';
	default: return null;
	}
}

// AT+GTACT? -> <rat>,<pref1>,<pref2>[,<band>...]
function parse_gtact(line) {
	if (!line)
		return null;
	const v = int_list(replace(line, /^\+GTACT:\s*/, ''));
	if (!length(v))
		return null;
	const bands = [];
	for (let i = 3; i < length(v); i++)
		push(bands, v[i]);
	// pref_label is what a view should DISPLAY, and it is not simply pref1 + pref2.
	//
	// The two preference slots are frequently identical - `+GTACT: 14,6,6,...` - partly because
	// we put them there ourselves: when the modem reports an empty second preference (it emits
	// `+GTACT: 14,6,` but refuses to accept one back), the guard's gtact_replayable() fills the
	// gap from the RAT, and for a single-RAT mode both slots resolve to the same value. Rendering
	// that as an ordered list produced "Preferred: NR > NR" on the Radio and Status pages - an
	// ordering between a thing and itself, which reads as a bug even though the radio is fine.
	//
	// Collapsed HERE rather than in each view: two views were already joining these fields with
	// the identical expression, so fixing it in one would have left the other still saying
	// "NR > NR". The raw pref1/pref2 stay exposed for anything that needs the real values.
	const p1 = gtact_pref_name(v[1] ?? -1);
	const p2 = gtact_pref_name(v[2] ?? -1);
	const parts = [];
	for (let p in [ p1, p2 ])
		if (p && !(p in parts))
			push(parts, p);

	return {
		rat: v[0], rat_name: gtact_rat_name(v[0]),
		pref1: v[1] ?? null, pref1_name: p1,
		pref2: v[2] ?? null, pref2_name: p2,
		pref_label: length(parts) ? join(' > ', parts) : null,
		bands: bands
	};
}

// AT+EMMCHLCK? -> `+EMMCHLCK: 0` unlocked, or `+EMMCHLCK: 1,7,0,1650,187,0` locked.
//
// ⚠️ The READ form returns SIX fields where the SET form takes five, so a value read back
// cannot be replayed verbatim - the guard trims it before restoring.
//
// This command is absent from AT+CLAC, which lists 37 commands and misses it: the third
// instance of CLAC under-reporting on this firmware. CLAC finding a command proves presence;
// CLAC missing one proves nothing at all.
function parse_emmchlck(line) {
	if (!line)
		return { cell_locked: null };
	const v = int_list(replace(line, /^\+EMMCHLCK:\s*/, ''));
	if (!length(v) || v[0] == 0)
		return { cell_locked: false };
	return {
		cell_locked: true,
		cell_rat: v[1] ?? null,
		cell_arfcn: v[3] ?? null,
		cell_pci: v[4] ?? null
	};
}

// AT+EMMCHLCK=? -> (0-1),(0,2,7),(0,1),(0-46589),(0-511)
// The ARFCN and PCI ceilings drive the UI's input validation, so it tracks the firmware
// rather than a hard-coded LTE range that a different build might not share.
function parse_emmchlck_caps(line) {
	if (!line)
		return null;
	const g = paren_groups(line);
	if (length(g) < 5)
		return null;
	const rng = function(s) {
		const m = match(s, /^(\d+)-(\d+)$/);
		return m ? { min: +m[1], max: +m[2] } : null;
	};
	return {
		rats: int_list(g[1]),
		arfcn: rng(trim(g[3])),
		pci: rng(trim(g[4]))
	};
}

// AT+GTDUALSIM? -> `+GTDUALSIM : 0, "SUB1", "L"`
// ⚠️ There is a SPACE before the colon and after each comma on this firmware. A regex
// anchored on `+GTDUALSIM:` does not match. Measured, not guessed.
function parse_dualsim(line) {
	const m = line ? match(line, /\+GTDUALSIM\s*:\s*(\d+)\s*,\s*"([^"]*)"\s*,\s*"([^"]*)"/) : null;
	if (!m)
		return {};
	return { sim_slot: +m[1], sim_sub: m[2], sim_service: m[3] };
}

// AT+GTCAINFO? -> `PCC:<band>,<pci>,<earfcn>,<dl_bw>,<ul_bw>,<dl_mimo>,<ul_mimo>,<dl_mod>,
//                       <ul_mod>,<rsrp>` and optional `SCCn:` lines.
//
// ⚠️ The manual documents EIGHT fields for PCC; this firmware emits TEN - it omits
// <ul_bandwidth> and the trailing RSRP from its spec. Parse positionally from the observed
// shape and tolerate a short reply rather than trusting the documented count.
function parse_ca_line(line) {
	const m = match(line, /^(PCC|SCC\d*)\s*:\s*(.*)$/);
	if (!m)
		return null;
	const v = int_list(m[2]);
	// SCC rows lead with <scell_state>,<ul_configured> before the band; PCC does not.
	const scc = (m[1] != 'PCC');
	const o = scc ? 2 : 0;
	if (length(v) < o + 3)
		return null;
	return {
		carrier: m[1],
		state: scc ? v[0] : null,
		band: v[o], band_label: band_label(v[o]),
		pci: v[o + 1],
		arfcn: v[o + 2],
		dl_bandwidth: v[o + 3] ?? null,
		ul_bandwidth: v[o + 4] ?? null,
		dl_mimo: v[o + 5] ?? null,
		ul_mimo: v[o + 6] ?? null,
		dl_modulation: v[o + 7] ?? null,
		ul_modulation: v[o + 8] ?? null
	};
}

// AT+GTCCINFO? rows. The serving and neighbour rows have DIFFERENT field counts and
// different meanings - the serving row carries <band> and <bandwidth>, the neighbour row
// leaves both empty - so they cannot share one positional parser.
//
//   serving:   1,<rat>,<mcc>,<mnc>,<tac>,<cellid>,<arfcn>,<pci>,<band>,<bw>,<snr>,<rxlev>,<rsrp>,<rsrq>
//   neighbour: 2,<rat>,,,<tac>,<cellid>,<arfcn>,<pci>,,<rxlev>,<rsrp>,<rsrq>
//
// Conversion here is the rxlev scale of manual §11.1.15, which is NOT the +CESQ scale:
//   RSRP dBm = v - 140     RSRQ dB = (v/2) - 19.5
function parse_cell_row(line) {
	const f = split(trim(line), ',');
	if (length(f) < 8)
		return null;
	const serving = (trim(f[0]) == '1');
	const rat = +trim(f[1]);
	if (rat != 2 && rat != 4 && rat != 9)
		return null;
	// Drives both the field layout of a neighbour row and the dBm conversion below.
	const nr = (rat == 9);

	const num = function(x) {
		const t = trim(x ?? '');
		return (t == '' || !match(t, /^-?[0-9]+$/)) ? null : +t;
	};

	const row = {
		serving: serving,
		rat: rat,
		rat_name: (rat == 9) ? 'NR' : (rat == 4) ? 'LTE' : 'UMTS',
		mcc: trim(f[2] ?? '') != '' ? trim(f[2]) : null,
		mnc: trim(f[3] ?? '') != '' ? trim(f[3]) : null,
		tac: trim(f[4] ?? '') != '' ? trim(f[4]) : null,
		cellid: trim(f[5] ?? '') != '' ? trim(f[5]) : null,
		arfcn: num(f[6]),
		pci: num(f[7])
	};

	// Field 8 onwards diverges between the two shapes.
	let rsrp, rsrq;
	if (serving) {
		const b = num(f[8]);
		row.band = b;
		row.band_label = (b != null) ? band_label(b) : null;
		row.bandwidth = num(f[9]);
		row.snr = num(f[10]);
		rsrp = num(f[12]);
		rsrq = num(f[13]);
	} else {
		// Position 8 is <bandwidth> on an LTE neighbour but <ss_sinr> on an NR one; 9-11
		// (rxlev, rsrp, rsrq) line up for both.
		if (nr) row.snr = num(f[8]);
		else    row.bandwidth = num(f[8]);
		rsrp = num(f[10]);
		rsrq = num(f[11]);
	}

	// ⚠️ THE SCALES ARE RAT-DEPENDENT, exactly like +CESQ - and this code got it wrong first
	// time by applying the LTE formula to NR rows. Manual §11.1.15 defines two ladders:
	//   LTE  0 -> RSRP < -140 dBm,  96 -> -45..-44      =>  RSRP    = value - 140
	//   NR   0 -> SS-RSRP < -156,  126 -> >= -31        =>  SS-RSRP = value - 156
	// Caught on a hand-locked NR cell: raw ss_rsrq 77 rendered as +19.5 dB through the LTE
	// formula. RSRQ is never positive, which is what made it obvious - the RSRP error
	// (-94 instead of -110) looked perfectly plausible and would have gone unnoticed.
	// 255 means "not known or not detectable" and must read as absent, not as a number.
	const rsrp_floor = nr ? 156 : 140;
	const rsrq_off   = nr ? 43  : 19.5;
	row.rsrp = (rsrp != null && rsrp != 255) ? rsrp - rsrp_floor : null;
	row.rsrq = (rsrq != null && rsrq != 255) ? (rsrq / 2) - rsrq_off : null;

	// ⚠️ SANITY-CLAMP, because this modem reports NR neighbour values OUTSIDE the documented
	// 0-255 ladder. Measured in one snapshot, same command, same second:
	//     ...,633984,422,,336,336,55   -> 336 - 156 = +180 dBm   impossible
	//     ...,174750,521,,51,51,60     ->  51 - 156 = -105 dBm   plausible
	// The manual gives no scale that makes 336 meaningful, so any number derived from it is
	// invented. A dash is honest; "+180 dBm" is not, and a plausible-looking wrong figure is
	// worse than an absent one - the same reason QCI and the modulation codes are not decoded.
	// Physical bounds: SS-RSRP/RSRP bottom out around -156/-140 and never exceed about -30;
	// RSRQ is a ratio and is never positive.
	if (row.rsrp != null && (row.rsrp > -30 || row.rsrp < -160))
		row.rsrp = null;
	if (row.rsrq != null && (row.rsrq > 0 || row.rsrq < -45))
		row.rsrq = null;
	return row;
}

// Cell-lock ranges, from the modem's own AT+EMMCHLCK=?. ONE definition, because radio_info
// ships these bounds to the UI for input validation and cell_set enforces them server-side -
// two copies could drift into the UI advertising a range the backend rejects, or worse
// accepting one it should not. Mirrored to /var/run like radio_caps so an rpcd restart (which
// LuCI triggers on package install) does not re-pay an AT acquisition for a static value.
function cell_caps() {
	return cached('cell_caps', 86400, false, function() {
		const disk = readfile('/var/run/fm350-emmchlck-caps') ?? '';
		if (trim(disk) != '') {
			const c = parse_emmchlck_caps(trim(disk));
			if (c) return c;
		}
		const r = atq_batch([ 'AT+EMMCHLCK=?' ]);
		const l = first_line(r, 'AT+EMMCHLCK=?', '+EMMCHLCK:');
		if (l)
			run(`printf '%s' ${shq(l)} > /var/run/fm350-emmchlck-caps 2>/dev/null`);
		return parse_emmchlck_caps(l);
	}).data;
}

// Write the guard's request file and start it via procd.
//
// Deliberately not `popen` + background: this window lasts minutes and must survive an rpcd
// restart, which LuCI itself triggers. The request goes in a FILE because a procd instance's
// argv is fixed when start_service runs and `/etc/init.d/... start` forwards no arguments.
function start_guard(body) {
	const st = readfile(GUARD_STATE) ?? '';
	// Refuse rather than queue: a second apply would act on state the first is still
	// changing, and the modem cannot be retuned twice at once.
	if (match(st, /STATE=(applying|verifying|reverting)/))
		return { ok: false, error: 'a radio change is already in progress' };

	const fd = popen('cat > /var/run/fm350-radio.req', 'w');
	if (!fd)
		return { ok: false, error: 'could not write the request' };
	fd.write(body);
	fd.close();

	run('/etc/init.d/fm350-radio start >/dev/null 2>&1');
	cache_drop('radio_cfg');
	cache_drop('live');
	return { ok: true, note: 'applying; the link drops briefly and reverts itself if it fails' };
}

// Concatenated-SMS grouping was moved verbatim into the shared module loaded above, so the
// archive worker and this backend cannot drift apart. `group_messages(msgs)` groups segments
// on (sender, reference, total), sorts by part and joins content; the full rationale lives in
// the module. Kept as a one-line alias so the callers below (and the unit test's expectations)
// read the same as before.
function group_messages(msgs) { return grouping.group_messages(msgs); }

// Level-gated logging for this backend, through UCI's `h5000m.logging.ui` (falling back to
// the global `h5000m.logging.level`) - the SAME ordinal contract the `h5000m` log.sh library
// uses everywhere else, but this backend is ucode and log.sh is POSIX shell, so it cannot be
// sourced here. This is a deliberately NARROWER subset of that contract: level-gating only,
// no redaction and no dedup. Nothing logged through this call ever carries SMS bodies, phone
// numbers or other identifiers - only small integers/booleans (archiver settings) or a fixed
// parse-failure notice - so there is nothing here that needs masking. If a future caller ever
// needs to log something sensitive, it must NOT go through this helper unmodified.
const LOG_LEVELS = { error: 0, warn: 1, info: 2, debug: 3, trace: 4 };

// ⚠️ A LEVEL NAME IS NOT ALWAYS A SYSLOG PRIORITY. LOG_LEVELS admits `trace` and `warn`;
// syslog has neither `daemon.trace` nor, on some implementations, `daemon.warn` as spelled.
// log.sh carries an explicit name->priority table for exactly this reason, and the first
// version of this function copied the ordinal gate but not the mapping - so a future
// ui_log('trace', …) would have been dropped by logger with 2>/dev/null hiding why.
function syslog_prio(level) {
	switch (level) {
	case 'error': return 'err';
	case 'warn':  return 'warning';
	case 'info':  return 'info';
	default:      return 'debug';
	}
}

function ui_log(level, msg) {
	// Cached: two forks to decide whether to emit, paid even when the line is then suppressed,
	// on a value that changes about never. 300s is far shorter than the interval at which
	// anyone edits a log level, and this is the primitive every future backend log line will
	// route through.
	const want = cached('ui_loglevel', 300, false, function() {
		const u = uci_section('h5000m.logging');
		const name = (u.ui ?? '') != '' ? u.ui : (((u.level ?? '') != '') ? u.level : 'info');
		return LOG_LEVELS[name] ?? LOG_LEVELS.info;
	}).data;
	if ((LOG_LEVELS[level] ?? LOG_LEVELS.info) > want)
		return;
	run(`logger -t fm350-ui -p daemon.${syslog_prio(level)} ${shq(msg)} 2>/dev/null`);
}

// Single source for the modem store's used/total counters - sms_list and archive_get both
// need them, and a second copy of this regex would be exactly the kind of drift this file's
// own comments elsewhere warn about.
// ⚠️ THIS TAKES THE SHARED AT-PORT LEASE, and rpcd is SINGLE-THREADED - while it runs, every
// LuCI page is frozen, not just this one. h5000m-sms defaults to AT_PRIO=20 (the user tier,
// above the archiver and the cell collector), AT_LEASE_WAIT=30 and H5000M_SMS_TIMEOUT=45, so
// left alone a single page load could block rpcd for ~75s. That contradicts this file's own
// header rule - lowest tier, short waits, contention surfaces as "modem busy" rather than a
// hung page - which the original call simply did not apply. All three are env-overridable.
//
// Cached because two callers (sms_list and archive_get) want the same number and the store
// count moves slowly; 15s also collapses the re-read that follows an Apply. Volatile so the
// guard changing radio state still invalidates it.
function sms_status() {
	return cached('sms_status', 15, true, function() {
		const s = run('AT_PRIO=1 AT_LEASE_WAIT=3 H5000M_SMS_TIMEOUT=10 ' +
		              '/usr/sbin/h5000m-sms status 2>/dev/null') ?? '';
		const m = match(s, /used:\s*(\d+),\s*total:\s*(\d+)/);
		return { used: m ? +m[1] : null, total: m ? +m[2] : null };
	}).data;
}

// One `uci show <section>` instead of one `uci -q get` fork per option. Each run() is a popen
// plus a /bin/sh plus a uci - reading five options cost ten processes on a ~1 GHz MIPS board.
// log.sh documents the identical fix on the shell side ("four forks each turned into 28").
// Returns {} for a missing section, so callers' defaults still apply.
function uci_section(path) {
	const out = run(`uci -q show ${path} 2>/dev/null`) ?? '';
	const vals = {};
	for (let line in split(out, '\n')) {
		// uci show emits `cfg.section.option='value'`. Capture the value WHOLE and strip the
		// quotes afterwards - an optional `'?` against a non-greedy `(.*?)` lets the closing
		// quote fall inside the capture instead, which shipped as `interface: "cellular'"` and
		// turned every numeric option into NaN.
		const m = match(trim(line), /^[^=]*\.([^.=]+)=(.*)$/);
		if (!m)
			continue;
		let v = m[2];
		if (length(v) > 1 && substr(v, 0, 1) == "'" && substr(v, -1) == "'")
			v = substr(v, 1, length(v) - 2);
		vals[m[1]] = v;
	}
	return vals;
}

// Count archived messages WITHOUT rebuilding them. read_archive() allocates an 11-field object
// per message to reshape it for the inbox merge; archive_get only ever called length() on the
// result, and max_messages defaults to 0 (unbounded), so N is user-controlled.
function archive_count() {
	const raw = readfile(SMS_ARCHIVE);
	if (!raw)
		return 0;
	try {
		return length(json(raw)?.messages ?? []);
	} catch (e) {
		return 0;
	}
}

// True only if procd reports a LIVE instance. The service is always started at boot
// (postinst runs `/etc/init.d/h5000m-sms-archive enable`) - `running` reflects the PROCESS,
// the UCI `enabled` flag reflects whether it is actively doing anything each cycle. The two
// are deliberately distinct on the settings page: a stopped service and a disabled one look
// different to an operator and mean different things.
function archive_running() {
	try {
		const bus = connect();
		const r = bus.call('service', 'list', { name: 'h5000m-sms-archive' });
		bus.disconnect();
		const inst = r?.['h5000m-sms-archive']?.instances ?? {};
		for (let k in inst)
			if (inst[k]?.running)
				return true;
		return false;
	} catch (e) {
		return false;
	}
}

// Ephemeral (/var/run - tmpfs, gone on reboot) one-line-per-field summary the archiver's shell
// driver writes after every cycle it actually runs. This is NOT the durable archive - it is
// purely so the settings page can show "when did this last run and what happened" without
// grepping logread. Missing/unparseable -> all null, the same graceful-degradation posture
// read_archive() already uses for absent runtime state.
function archive_status_file() {
	const out = { last_run: null, last_result: null, last_summary: null };
	const raw = readfile('/var/run/h5000m-sms-archive.status');
	if (raw == null || raw == '')
		return out;
	for (let line in split(raw, '\n')) {
		const m = match(line, /^([a-z_]+)=(.*)$/);
		if (!m) continue;
		// last_run is a formatted "YYYY-MM-DD HH:MM:SS" string, not an epoch - the shell
		// driver deliberately avoids `date +%s` here (see its own comment) since this is a
		// display timestamp, not a deadline, and the wall-clock-deadline invariant this repo
		// enforces elsewhere does not distinguish the two by content alone.
		if (m[1] == 'last_run') out.last_run = (m[2] != '') ? m[2] : null;
		else if (m[1] == 'last_result') out.last_result = m[2];
		else if (m[1] == 'last_summary') out.last_summary = m[2];
	}
	return out;
}

// Read the persistent archive. Missing or unparseable -> empty, no error surfaced: the same
// graceful-degradation posture the rest of this backend uses for absent runtime state. Returns
// the archived messages already shaped like grouped live messages so the view renders both
// uniformly - `origin: 'archived'` and a stable `id` are what the delete path keys on.
function read_archive() {
	const raw = readfile(SMS_ARCHIVE);
	if (raw == null || raw == '')
		return [];
	let doc = null;
	try { doc = json(raw); } catch (e) { doc = null; }
	const list = doc?.messages ?? [];
	const out = [];
	for (let a in list) {
		push(out, {
			origin: 'archived',
			id: a.id,
			// Archived rows carry no live storage slots (they were deleted from the modem);
			// the delete path uses `id`, and `indexes: []` keeps the view's shared code happy.
			index: null, indexes: [],
			sender: a.sender, timestamp: a.timestamp,
			content: a.content, error: a.error ?? null,
			parts: a.parts ?? a.total ?? 1, total: a.total ?? 1,
			complete: a.complete ?? true
		});
	}
	return out;
}

// Remove one archived message by id and rewrite the file atomically (temp + rename, so a
// concurrent read never sees a half-written file). Preserves `next_id` and every other entry.
// This can race the archive worker, which also rewrites the file; both use atomic rename so the
// loser of a race is overwritten cleanly, never corrupted - acceptable for a personal router
// where the two rarely touch it at the same instant.
function delete_archived(id) {
	if (id == null || id == '')
		return { ok: false, error: 'id is required for an archived delete' };
	const raw = readfile(SMS_ARCHIVE);
	if (raw == null || raw == '')
		return { ok: false, error: 'no archive file' };
	let doc = null;
	try { doc = json(raw); } catch (e) { doc = null; }
	if (doc == null)
		return { ok: false, error: 'archive file is unreadable' };

	const kept = [];
	let removed = false;
	for (let a in (doc.messages ?? [])) {
		if (a.id == id) removed = true;
		else push(kept, a);
	}
	if (!removed)
		return { ok: false, error: 'no archived message with that id' };

	doc.messages = kept;
	const tmp = SMS_ARCHIVE + '.tmp';
	if (writefile(tmp, sprintf('%J', doc)) == null)
		return { ok: false, error: 'could not write the archive' };
	if (!rename(tmp, SMS_ARCHIVE))
		return { ok: false, error: 'could not replace the archive' };
	return { ok: true, deleted: 1 };
}

const methods = {
	// ttl lets the view ask for fresher data in live mode without a second code path.
	status: {
		args: { ttl: 0 },
		call: function(req) {
			// Clamp: the caller is a web page and this drives AT traffic on the port the
			// dialer needs. A 0 would mean "every render takes the lock".
			let ttl = req.args?.ttl ?? 15;
			if (ttl < 2) ttl = 2;
			if (ttl > 60) ttl = 60;
			const r = cached('live', ttl, true, collect_status);
			return { ...r.data, cached: r.cached, age: r.age };
		}
	},

	// Carrier aggregation, MIMO and modulation. Its own batch and its own TTL: <1s, but
	// pointless to refresh on the 3s live tick, and it must not ride along with a command
	// whose timeout would extend this one's lock hold.
	ca_info: {
		call: function() {
			const r = cached('ca', 15, true, function() {
				const res = atq_batch([ 'AT+GTCAINFO?' ]);
				const e = res?.['AT+GTCAINFO?'];
				const carriers = [];
				if (e && e.rc == 0)
					for (let l in e.lines) {
						const c = parse_ca_line(l);
						if (c) push(carriers, c);
					}
				return { carriers: carriers, reachable: !!(e && e.rc == 0) };
			});
			return { ...r.data, cached: r.cached, age: r.age };
		}
	},

	// Radio configuration and capabilities. `radio_caps` is immutable per firmware, so it is
	// cached for a day AND mirrored to /var/run so an rpcd restart does not re-pay for it.
	radio_info: {
		call: function() {
			const cfg = cached('radio_cfg', 30, true, function() {
				const res = atq_batch([ 'AT+GTACT?', 'AT+GTDUALSIM?', 'AT+SIMTYPE?', 'AT+EMMCHLCK?' ]);
				const st = first_line(res, 'AT+SIMTYPE?', '+SIMTYPE:');
				const sm = st ? match(st, /\+SIMTYPE:\s*(\d+)/) : null;
				return {
					...(parse_gtact(first_line(res, 'AT+GTACT?', '+GTACT:')) ?? {}),
					...parse_dualsim(first_line(res, 'AT+GTDUALSIM?', '+GTDUALSIM')),
					...parse_emmchlck(first_line(res, 'AT+EMMCHLCK?', '+EMMCHLCK')),
					sim_type: sm ? +sm[1] : null,
					sim_type_name: sm ? (+sm[1] == 1 ? 'eSIM' : 'USIM') : null
				};
			});

			const caps = cached('radio_caps', 86400, false, function() {
				let c = null;
				const disk = readfile('/var/run/fm350-gtact-caps') ?? '';
				if (disk != '')
					c = parse_gtact_caps(trim(disk));
				if (!c) {
					// -t 10: the capability reply is long and the default 5s truncates it.
					const res = atq_batch([ 'AT+GTACT=?' ]);
					const l = first_line(res, 'AT+GTACT=?', '+GTACT:');
					c = parse_gtact_caps(l);
					if (c && l)
						run(`printf '%s' ${shq(l)} > /var/run/fm350-gtact-caps 2>/dev/null`);
				}
				return c ?? { rats: [], umts: [], lte: [], nr: [] };
			});

			// Labels are derived here rather than in the view so the encoding rule lives in
			// exactly one place.
			const label = function(list) {
				const o = [];
				for (let b in list) push(o, { value: b, label: band_label(b), group: band_group(b) });
				return o;
			};

			// RATs are labelled HERE, not in the view. The view needs a name per mode, and
			// a second copy of the §11.1.14 enumeration in JavaScript would drift from this
			// one the moment either is extended - silently, since a wrong mode name still
			// renders. One source, shipped as {value,label} like the bands already are.
			const rat_opts = [];
			for (let r in (caps.data.rats ?? []))
				push(rat_opts, { value: r, label: gtact_rat_name(r) });


			return {
				...cfg.data,
				cell_caps: cell_caps(),
				band_labels: label(cfg.data?.bands ?? []),
				caps: {
					rats: caps.data.rats,
					rat_options: rat_opts,
					bands: label([ ...caps.data.umts, ...caps.data.lte, ...caps.data.nr ])
				},
				cached: cfg.cached, age: cfg.age
			};
		}
	},

	// Neighbour cells. NEVER runs the AT command inline: rpcd is single-threaded, so a <3s
	// command plus lock wait would freeze every LuCI page, not just this one. A detached
	// collector writes CELLS_FILE atomically and this only reads it, returning the last known
	// data with `pending` set while a refresh is in flight. N tabs coalesce on the
	// collector's own flock rather than on tab count.
	cells: {
		args: { refresh: 0 },
		call: function(req) {
			const want = req.args?.refresh ?? 0;
			const raw = readfile(CELLS_FILE) ?? '';
			let doc = null;
			try { doc = json(raw); } catch (e) { doc = null; }

			// Age from the file's mtime, not from a timestamp written into it. That keeps
			// `date +%s` out of the collector entirely - this board has no RTC and the clock
			// steps at boot - and clamping at zero means a backwards step shows "just now"
			// rather than a negative age.
			const st = stat(CELLS_FILE);
			let age = st ? (time() - st.mtime) : null;
			if (age != null && age < 0) age = 0;

			const stale = (doc == null) || (age == null) || (age > 60) || want;
			if (stale)
				run('/usr/sbin/fm350-collect-cells >/dev/null 2>&1');

			const rows = [];
			for (let l in (doc?.lines ?? [])) {
				const c = parse_cell_row(l);
				if (c) push(rows, c);
			}
			// Serving cell first, then neighbours strongest-first: the useful reading order.
			sort(rows, function(a, b) {
				if (a.serving != b.serving) return a.serving ? -1 : 1;
				return (b.rsrp ?? -999) - (a.rsrp ?? -999);
			});

			// Hard cap. Up to ten neighbours PER RAT can be reported, and an oversized
			// blobmsg makes the ubus call fail outright rather than truncate - the page
			// would show nothing at all instead of a shortened list.
			const capped = length(rows) > 12;
			return {
				cells: capped ? slice(rows, 0, 12) : rows,
				truncated: capped,
				age: age,
				// `pending` means "a refresh is running; this may be older than it looks" -
				// rendered as a note, never as a spinner that never resolves.
				pending: stale,
				reachable: doc ? (doc.reachable ?? false) : false
			};
		}
	},

	// Progress of an in-flight band/slot apply. The UI polls this instead of holding a
	// request open, because the apply window outlives any HTTP request by design.
	radio_state: {
		call: function() {
			const raw = readfile(GUARD_STATE) ?? '';
			const s = match(raw, /STATE=(\S*)/);
			const d = match(raw, /DETAIL=(.*)/);
			return {
				state: s ? s[1] : 'idle',
				detail: d ? trim(d[1]) : '',
				// A pending record means a SIM switch is awaiting explicit confirmation;
				// left unconfirmed it is rolled back at the second boot.
				awaiting_confirm: !!stat('/etc/h5000m/simslot.pending')
			};
		}
	},

	// Hand off to the procd guard rather than doing the work here. rpcd must not own a
	// multi-minute apply-verify-revert window: it is single-threaded, and a LuCI-triggered
	// rpcd restart would kill exactly the timer that protects the user.
	band_set: {
		args: { rat: 0, bands: 'string' },
		call: function(req) {
			const rat = req.args?.rat;
			if (rat == null || rat < 0)
				return { ok: false, error: 'rat is required' };

			// Screen every band before it reaches a shell word or an AT command. The guard
			// runs this string through AT+GTACT=, and a malformed set command is how this
			// modem has previously been wedged.
			const bands = [];
			for (let p in split(req.args?.bands ?? '', ',')) {
				const t = trim(p);
				if (t != '' && match(t, /^[0-9]{1,5}$/))
					push(bands, t);
			}
			return start_guard(`ACTION=band\nRAT=${+rat}\nBANDS="${join(' ', bands)}"\n`);
		}
	},

	// Cell lock. The heavy lifting - CFUN cycle, reselection wait, revert - is the guard's;
	// this only validates and hands off, for the same reason band_set does.
	cell_set: {
		args: { arfcn: 0, pci: 0, lte_only: 0 },
		call: function(req) {
			const a = req.args?.arfcn, p = req.args?.pci;
			if (a == null || p == null)
				return { ok: false, error: 'arfcn and pci are required' };
			// Bounds come from the modem's own AT+EMMCHLCK=? rather than a hard-coded LTE
			// range, so this tracks the firmware.
			const c = cell_caps();
			if (c?.arfcn && (a < c.arfcn.min || a > c.arfcn.max))
				return { ok: false, error: `arfcn must be ${c.arfcn.min}-${c.arfcn.max}` };
			if (c?.pci && (p < c.pci.min || p > c.pci.max))
				return { ok: false, error: `pci must be ${c.pci.min}-${c.pci.max}` };
			return start_guard(`ACTION=cell\nCELL_ARFCN=${+a}\nCELL_PCI=${+p}\n` +
			                   `CELL_LTE_ONLY=${req.args?.lte_only ? 1 : 0}\n`);
		}
	},

	cell_unlock: {
		call: function() {
			// An empty ARFCN is the guard's unlock signal; it also puts back any RAT
			// narrowing the lock applied.
			return start_guard('ACTION=cell\nCELL_ARFCN=\nCELL_PCI=\nCELL_LTE_ONLY=0\n');
		}
	},

	band_unlock: {
		call: function() {
			// RAT 10 is the modem's own "automatic"; with no band list it clears the lock
			// for every RAT at once.
			return start_guard('ACTION=band\nRAT=10\nBANDS=""\n');
		}
	},

	sim_set: {
		args: { slot: 0 },
		call: function(req) {
			const slot = req.args?.slot;
			if (slot != 0 && slot != 1)
				return { ok: false, error: 'slot must be 0 (SIM) or 1 (eSIM)' };
			return start_guard(`ACTION=slot\nSLOT=${+slot}\n`);
		}
	},

	sim_confirm: {
		call: function() {
			run('/usr/sbin/fm350-radio confirm >/dev/null 2>&1');
			return { ok: true };
		}
	},

	// TTL/hop-limit normalisation. The mechanism lives in h5000m-ttl (a separate package);
	// this only reads its UCI and runs the apply helper, so the nft generation has ONE owner.
	ttl_get: {
		call: function() {
			const c = uci_section('h5000m-ttl.settings');
			const g = function(o, d) { return (c[o] ?? '') != '' ? c[o] : d; };
			// Reported so the UI can state the real consequence rather than a generic warning:
			// offloaded flows never traverse postrouting, so with offloading on only a flow's
			// first packets get rewritten - a mix of 64 and 63 fingerprints tethering just as
			// well as no rewrite at all.
			const fw = uci_section('firewall.@defaults[0]');
			const off = fw.flow_offloading ?? '';
			const offhw = fw.flow_offloading_hw ?? '';
			return {
				installed: !!stat('/usr/libexec/h5000m-ttl-apply'),
				enabled: g('enabled', '0') == '1',
				value: +g('value', '64'),
				interface: g('interface', 'cellular'),
				manage_offload: g('manage_offload', '1') == '1',
				flow_offloading: off == '1',
				flow_offloading_hw: offhw == '1',
				// True when the rule is actually in the live ruleset, not merely configured -
				// `nft list` showing a rule is the check people wrongly trust, so report the
				// real thing and let the view say counters do not prove the wire value.
				active: !!match(run("nft list chain inet fw4 mangle_postrouting 2>/dev/null") ?? '', /ttl set/)
			};
		}
	},

	ttl_set: {
		args: { enabled: 0, value: 0, manage_offload: 0 },
		call: function(req) {
			const v = req.args?.value ?? 64;
			if (v < 1 || v > 255)
				return { ok: false, error: 'value must be 1-255' };
			if (!stat('/usr/libexec/h5000m-ttl-apply'))
				return { ok: false, error: 'h5000m-ttl is not installed' };

			run(`uci -q set h5000m-ttl.settings.enabled=${req.args?.enabled ? 1 : 0}`);
			run(`uci -q set h5000m-ttl.settings.value=${+v}`);
			run(`uci -q set h5000m-ttl.settings.manage_offload=${req.args?.manage_offload ? 1 : 0}`);
			run('uci -q commit h5000m-ttl');
			// Synchronous and quick - this is nft generation plus one fw4 reload, not an AT
			// transaction, so it does not need the guard's apply/verify machinery.
			const out = run('/usr/libexec/h5000m-ttl-apply 2>&1') ?? '';
			return { ok: true, output: trim(out) };
		}
	},

	sms_list: {
		call: function() {
			// sms_tool decodes PDU and UCS2, but it does NOT reassemble concatenated SMS -
			// it parses the UDH and hands us one object per SEGMENT. Grouping is ours.
			const out = run('/usr/sbin/h5000m-sms -j recv 2>/dev/null');
			let msgs = [];
			try {
				msgs = json(out)?.msg ?? [];
			} catch (e) {
				// Do NOT swallow this into an empty inbox: that is indistinguishable from a
				// genuinely empty store and hid a real parse failure. Warn, then continue with
				// no live messages so the archived ones still render.
				ui_log('warn', `sms_list: could not parse recv JSON (${e}) - showing archived only`);
				msgs = [];
			}

			// Tag each grouped live message so the view and the delete path can tell it from
			// an archived one - a live delete talks to the modem, an archived delete rewrites
			// the archive file.
			const live = group_messages(msgs);
			for (let g in live) g.origin = 'live';

			// Merge in the persistent archive. Concatenate, then sort newest-first through the
			// SAME comparator the archiver sorts oldest-first with, so archived and live rows
			// interleave by time instead of appearing as two separate blocks. Note this makes
			// the inbox time-ordered rather than storage-ordered - newest-first, the natural
			// inbox order - even when the archive is empty.
			const archived = read_archive();
			const all = [ ...live, ...archived ];
			sort(all, function(a, b) { return grouping.cmp_timestamp(b.timestamp, a.timestamp); });

			// Storage counters, so a filling store is visible BEFORE it starts silently
			// rejecting messages. There is no read/unread flag anywhere in this data.
			//
			// `used` counts SEGMENTS, because that is what occupies slots - one 6-part
			// Chinese message really does consume 6 of 90. Reporting the grouped count here
			// would understate how full the store is, which is the opposite of useful.
			// used/total stay MODEM-ONLY: they are the number actually at risk of overflowing;
			// archived messages are off the modem and cannot fill it.
			const st = sms_status();
			return {
				messages: all,
				segments: length(msgs),
				archived_count: length(archived),
				used: st.used,
				total: st.total
			};
		}
	},

	sms_send: {
		// args is a TYPE-EXEMPLAR map: the value sets the blobmsg type, and a method
		// declaring no args accepts no parameters at all - the payload would be dropped
		// silently. These names must match rpc.declare's params: exactly.
		args: { number: 'string', text: 'string' },
		call: function(req) {
			const num = req.args?.number ?? '';
			const txt = req.args?.text ?? '';
			if (num == '' || txt == '')
				return { ok: false, error: 'number and text are both required' };
			const out = run(`/usr/sbin/h5000m-sms send ${shq(num)} ${shq(txt)} 2>&1`);
			// sms_tool reports failure in prose; treat any mention of error as failure
			// rather than trusting an exit code we cannot see through popen.
			const bad = match(out ?? '', /[Ee]rror|ERROR|failed/);
			return { ok: !bad, output: trim(out ?? '') };
		}
	},

	sms_delete: {
		// `indexes` is a comma-separated list because a multipart message occupies one
		// storage slot PER SEGMENT: deleting only the slot the user clicked would leave the
		// other five behind, and a partially-deleted message can never be reassembled.
		// `index` is kept for a single-segment delete and as the older calling convention.
		// `origin`/`id` route an ARCHIVED delete: origin='archived' + id removes the entry
		// from the archive file with no AT interaction. origin absent or 'live' = the modem
		// path below.
		args: { index: 0, indexes: 'string', origin: 'string', id: 'string' },
		call: function(req) {
			if (req.args?.origin == 'archived')
				return delete_archived(req.args?.id);

			let list = [];
			const raw = req.args?.indexes;
			if (raw != null && raw != '') {
				for (let p in split(raw, ',')) {
					const t = trim(p);
					// Screen every element: these become shell words, and a non-numeric
					// one has no legitimate meaning here.
					if (match(t, /^[0-9]+$/))
						push(list, t);
				}
			}
			else if (req.args?.index != null) {
				push(list, '' + req.args.index);
			}

			if (!length(list))
				return { ok: false, error: 'index or indexes is required' };

			const failed = [];
			let output = '';
			for (let i in list) {
				// ⚠️ SHORT per-slot timeout, deliberately far below h5000m-sms's 45s default.
				// A delete of a REAL slot takes about a second (measured: six slots in 6.9s).
				// The only thing that burns the full timeout is a slot that is already empty,
				// which makes sms_tool hang - and ubus gives this whole call ~30s before it
				// reports a timeout to the browser. At 45s per slot a single bad index would
				// blow that budget on its own and the UI would show "result unknown" for a
				// delete that eventually succeeded. 10s leaves room for a bad slot plus the
				// rest of a multipart group inside one ubus request.
				const out = run(`H5000M_SMS_TIMEOUT=10 /usr/sbin/h5000m-sms delete ${shq(i)} 2>&1`) ?? '';
				output += out;
				if (match(out, /[Ee]rror|ERROR|failed/))
					push(failed, i);
			}
			// Report a partial failure rather than claiming success: leftover segments are
			// exactly the state that makes an inbox confusing.
			if (length(failed))
				return { ok: false, deleted: length(list) - length(failed),
				         failed: failed, output: trim(output) };
			return { ok: true, deleted: length(list), output: trim(output) };
		}
	},

	// Router-side SMS FIFO archive (package h5000m-sms-archive, optional - EXTRA_DEPENDS on
	// luci-app-fm350). The mechanism is UCI-only otherwise: this is the settings page's read
	// side, mirroring ttl_get's shape (config + live/derived status in one call so the view
	// has no second round trip).
	archive_get: {
		call: function() {
			// ⚠️ INSTALLED FIRST, BEFORE ANY WORK. The package is EXTRA_DEPENDS, so "absent" is
			// the ORDINARY case, and the view discards every other field when installed is
			// false. Building the full response first meant a device without the archiver still
			// paid a real modem AT transaction plus a pile of forks to open this page, all of it
			// thrown away.
			//
			// The worker binary, not the init script: this is "can it actually do anything",
			// the same intent as ttl_get's `installed` check.
			if (!stat('/usr/sbin/h5000m-sms-archive-worker'))
				return { installed: false };

			const c = uci_section('h5000m.sms_archive');
			const g = function(o, d) { return (c[o] ?? '') != '' ? c[o] : d; };
			const stf = archive_status_file();
			return {
				installed: true,
				running: archive_running(),
				enabled: g('enabled', '0') == '1',
				threshold: +g('threshold', '70'),
				batch_size: +g('batch_size', '10'),
				interval: +g('interval', '900'),
				max_messages: +g('max_messages', '0'),
				// storage_path is deliberately NOT returned. read_archive() reads the SMS_ARCHIVE
				// constant and ignores UCI, so reporting the UCI value would advertise a setting
				// the backend does not honour - a field that starts lying the moment anyone edits
				// it. No consumer read it.
				archived_count: archive_count(),
				// Cheap now: sms_status() is cached and runs at the lowest AT tier.
				used: sms_status().used, total: sms_status().total,
				last_run: stf.last_run,
				last_result: stf.last_result,
				last_summary: stf.last_summary
			};
		}
	},

	// Every bound here is enforced server-side ONLY - the view screens blank/NaN and shows
	// whatever error string comes back, the same split TTL uses, so the range has one owner.
	// None of these five values need a service restart to take effect: the archiver re-reads
	// all of them from UCI every wake cycle by design (see h5000m-sms-archive's own header
	// comment) - only a LOG LEVEL change needs a restart, and that is not this method's concern.
	archive_set: {
		args: { enabled: 0, threshold: 0, batch_size: 0, interval: 0, max_messages: 0 },
		call: function(req) {
			const a = req.args ?? {};
			// Kept NUMERIC through validation and stringified only at the uci write below. The
			// first version coerced to string here and back with `+` twice per bound check.
			const fields = {
				enabled:      a.enabled ? 1 : 0,
				threshold:    +(a.threshold ?? 70),
				batch_size:   +(a.batch_size ?? 10),
				interval:     +(a.interval ?? 900),
				max_messages: +(a.max_messages ?? 0)
			};

			// Bounds: threshold/batch_size against the modem's realistic slot range (ME
			// storage can exceed the ~90 SM slots observed, but stays well under 500);
			// interval floors at 60s to match the driver's own floor, so a value rejected
			// here is never silently re-floored later without the caller knowing; 0 is a
			// valid, deliberate max_messages meaning "unbounded" (the shipped default).
			//
			// Table-driven because four hand-written blocks differing only in name/min/max is
			// how one of them ends up with the wrong bound or a message that disagrees with the
			// test it guards. The message is DERIVED from the same numbers it checks.
			const BOUNDS = [
				[ 'threshold',    1,  500,    'threshold must be 1-500' ],
				[ 'batch_size',   1,  100,    'batch_size must be 1-100' ],
				[ 'interval',     60, 86400,  'interval must be 60-86400 seconds' ],
				[ 'max_messages', 0,  100000, 'max_messages must be 0 (unbounded) to 100000' ]
			];
			for (let b in BOUNDS) {
				const v = fields[b[0]];
				if (v < b[1] || v > b[2]) {
					ui_log('warn', `sms_archive: rejected ${b[0]}=${v} (must be ${b[1]}-${b[2]})`);
					return { ok: false, error: b[3] };
				}
			}

			// Audit trail: this is the one write path that can turn on automatic message
			// deletion, so log exactly what changed - not just that "settings were saved".
			// Read-before-write rather than trusting the caller's own request, since a
			// no-op save (identical values re-submitted) should not spam syslog.
			// ONE `uci show` for the read-back, then ONE shell for every set plus the commit.
			// Previously this was up to eleven popens - five gets, five sets and a commit - each
			// costing a /bin/sh AND a uci, so ~22 processes for one Apply on a ~1 GHz board.
			const cur = uci_section('h5000m.sms_archive');
			const changed = [];
			let sets = '';
			for (let k in fields) {
				const old = cur[k] ?? '';
				// fields[k] is numeric; compare as strings because uci always reports strings.
				const val = '' + fields[k];
				if (old != val) {
					push(changed, `${k} ${old || '(unset)'}->${val}`);
					sets += `uci -q set h5000m.sms_archive.${k}=${shq(val)}; `;
				}
			}
			if (length(changed)) {
				run(sets + 'uci -q commit h5000m');
				ui_log('info', `sms_archive settings changed: ${join(', ', changed)}`);
			}
			return { ok: true, changed: length(changed) };
		}
	},

	reconnect: {
		call: function() {
			run(`/sbin/ifdown ${IFACE} 2>/dev/null; /sbin/ifup ${IFACE} 2>/dev/null`);
			cache_drop('live');
			return { ok: true };
		}
	},

	// The USB-level reset that recovers a half-dead endpoint. unbind/bind does NOT fix
	// that state and can make it worse; toggling `authorized` does. Runs detached because
	// it takes ~70s, far longer than an rpcd call may block.
	reset_modem: {
		call: function() {
			const usb = trim(run("sed -n 's/^MODEM_USBPATH=//p' /var/run/h5000m-modem.state 2>/dev/null") ?? '');
			const path = replace(usb, /'/g, '');
			if (path == '')
				return { ok: false, error: 'modem USB path unknown - is the modem enumerated?' };
			// Delegated to fm350-usb-reset, which detaches into its own SESSION. Doing the
			// toggle here as a backgrounded popen() left it in rpcd's process group, so an
			// `/etc/init.d/rpcd restart` during the 8s window - which LuCI itself triggers on
			// package install - would strand the modem at authorized=0 until a power cycle.
			run('/usr/sbin/fm350-usb-reset >/dev/null 2>&1');
			cache_drop('live');
			return { ok: true, usb_path: path, note: 'reset started; allow ~70s' };
		}
	},

	// Reports whether the AT endpoint is genuinely usable again. Deliberately checks with
	// stty rather than `ls`: the tty nodes reappear SECONDS BEFORE the endpoint works, and
	// checking for the node made two earlier recovery attempts look successful when they
	// were not.
	reset_status: {
		call: function() {
			const dev = trim(run("sed -n 's/^MODEM_AT_B=//p' /var/run/h5000m-modem.state 2>/dev/null") ?? '');
			const path = replace(dev, /'/g, '');
			if (path == '')
				return { ready: false, reason: 'no modem state yet' };
			const out = run(`stty -F ${shq(path)} -a 2>&1 | head -1`) ?? '';
			return { ready: !!match(out, /speed/), detail: trim(out) };
		}
	}
};

return { 'luci.fm350': methods };
