#!/bin/sh /etc/rc.common
# procd service for the SMS FIFO archiver.
#
# procd (the init system itself, always present) is used rather than cron because crond is a
# busybox compile-time option this plugin repo cannot assume is enabled on the pinned base
# image, whereas a USE_PROCD service is guaranteed available.
#
# The archiver is a resident loop, so it is respawned only if it actually exits: respawn
# 3600 5 5 = wait 5s before respawning, and stop treating exits as a crash-loop after an hour.
# It ships DISABLED in UCI (h5000m.sms_archive.enabled=0); the loop wakes, sees disabled and
# sleeps, so enabling is a UCI change with no service restart needed.
#
# START late - after the network and modem hotplug have settled. STOP early so a shutdown does
# not interrupt a delete mid-cycle any later than it must.

START=96
STOP=09

USE_PROCD=1
PROG=/usr/sbin/h5000m-sms-archive

start_service() {
	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
