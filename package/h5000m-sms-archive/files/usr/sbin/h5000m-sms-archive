#!/bin/sh
# Router-side SMS FIFO archiver - supervisor loop.
#
# procd runs this as a resident, respawning service. The heavy lifting is the ucode worker
# (h5000m-sms-archive-worker); this loop only decides WHEN to run it and never dies on a bad
# cycle, so there is no respawn storm (the process stays up) and no silent stall (every cycle
# retries independently).
#
# UCI is re-read every cycle, so enabled/interval/threshold/batch_size/max_messages/storage_path
# take effect on the NEXT cycle with no restart. Only the log LEVEL is read once at start (that
# is log.sh's documented behaviour, shared with the dialer); changing h5000m.logging.sms_archive
# needs `/etc/init.d/h5000m-sms-archive restart`.
#
# Also drops a small status file in /var/run (tmpfs - ephemeral by design, this is NOT the
# durable archive) after every cycle it actually runs, so the LuCI settings page can show "when
# did this last run and what happened" via archive_get without grepping logread. Written only
# when ENABLED=1 actually ran a cycle - a disabled archiver leaves whatever the last real run
# left behind, which is the correct "nothing has happened since" signal.

# shellcheck disable=SC1091
. /usr/lib/h5000m/log.sh
h5000m_log_init sms_archive

WORKER=/usr/sbin/h5000m-sms-archive-worker
STATUS_FILE=/var/run/h5000m-sms-archive.status
_fails=0

log_info "SMS archiver started"

while :; do
	ENABLED="$(uci -q get h5000m.sms_archive.enabled)"
	INTERVAL="$(uci -q get h5000m.sms_archive.interval)"
	case "$INTERVAL" in
		''|*[!0-9]*) INTERVAL=900 ;;
	esac
	# Floor the interval: this contends for the single AT port, and a misconfigured tiny value
	# must never turn the archiver into a busy-loop on the modem.
	[ "$INTERVAL" -ge 60 ] || INTERVAL=60

	if [ "$ENABLED" = 1 ]; then
		# AT_PRIO=5: below every user action, above the cosmetic status poll. h5000m-sms keeps
		# an already-set AT_PRIO, so recv/delete inside the worker inherit this tier.
		export AT_PRIO=5
		# A DISPLAY timestamp for the settings page, not a deadline - nothing here compares it
		# against a later `date` call. That distinction matters: this board has no RTC and NTP
		# steps the clock forward once the network is up, which is exactly what makes
		# date-derived DEADLINES unsafe elsewhere in this codebase. A one-shot capture for
		# "when did this last run" has no such hazard - it just occasionally reads as the image
		# build date until NTP corrects it, a cosmetic detail, not a bug.
		_ts="$(date '+%Y-%m-%d %H:%M:%S')"
		if _out="$("$WORKER" 2>&1)"; then
			_fails=0
			[ -n "$_out" ] && log_info "$_out"
			_result=ok
		else
			_fails=$((_fails + 1))
			log_warn "archive cycle failed: ${_out:-unknown error}"
			# Escalate ONCE at a run of failures so a persistent fault is visible without
			# flooding the log every interval.
			[ "$_fails" = 5 ] && log_error "archive cycle has failed 5 times in a row; still retrying every ${INTERVAL}s"
			_result=fail
		fi
		# tr collapses to one line: a crash could leave a multi-line ucode stack trace in
		# $_out, and the reader side parses this with a simple "name equals value" match
		# per line.
		#
		# ⚠️ Written to a temp file then RENAMED, never straight to $STATUS_FILE. The reader
		# (luci.fm350's archive_status_file) takes no lock, so a page load landing mid-write
		# would otherwise see a truncated file and render a garbled "Last cycle" row. rename is
		# atomic within a filesystem, so a reader sees either the old contents or the new, never
		# a mix. Every other producer/consumer pair here already does this - fm350-radio's say(),
		# fm350-collect-cells, save_archive - and this was the only one that did not.
		{
			printf 'last_run=%s\n' "$_ts"
			printf 'last_result=%s\n' "$_result"
			printf 'last_summary=%s\n' "$(printf '%s' "${_out:-no output}" | tr '\n' ' ')"
		} > "${STATUS_FILE}.$$" 2>/dev/null &&
			mv -f "${STATUS_FILE}.$$" "$STATUS_FILE" 2>/dev/null
		rm -f "${STATUS_FILE}.$$" 2>/dev/null
	fi

	# Backgrounded sleep + wait so a procd SIGTERM interrupts the wait promptly, the same idiom
	# the dialer uses.
	sleep "$INTERVAL" &
	wait $! 2>/dev/null
done
