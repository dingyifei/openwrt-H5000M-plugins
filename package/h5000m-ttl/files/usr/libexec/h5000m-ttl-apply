#!/bin/sh
# h5000m-ttl-apply - regenerate the cellular-egress TTL/hop-limit nft rule from UCI and
# reload fw4. Shared by the uci-defaults seeder and the iface hotplug hook so there is one
# source of truth; safe to run by hand.
#
# WHY nftables and not an AT command: the FM350 exposes no TTL knob (verified against a
# live AT+CLAC and the full AT manual), so the TTL is normalized router-side, the same way
# the stock vendor firmware did it (luci-app-qmodem-ttlfw4).
#
# ⚠️ WHY /usr/share/nftables.d AND NOT /etc/nftables.d: fw4 does NOT auto-include
# /etc/nftables.d - measured, it only globs /usr/share/nftables.d/{table,chain}-{pre,post}.
# A file dropped in /etc/nftables.d is silently ignored, and `fw4 check` still reports
# "Ruleset passes" precisely BECAUSE nothing was loaded, so the mistake looks like success.
# Confirm an include actually landed with:
#     fw4 print | grep h5000m-ttl
#
# chain-post/mangle_postrouting appends our rules INTO fw4's own base chain (which already
# exists at postrouting/mangle priority and carries the MTU-fixing rules) rather than
# declaring a second base chain on the same hook. One chain, defined order, nothing to
# reason about regarding which of two same-priority chains runs first.
#
# WHY the device is resolved every run: the cellular L3 device name is not stable (RNDIS/
# netdev names renumber), so we never bake one in. `network_get_device` turns the logical
# UCI interface into whatever device currently backs it, straight from ubus.
#
# No `set -e`: `uci -q get` on an absent key returns non-zero, which would abort the script.

. /lib/functions.sh
. /lib/functions/network.sh

TAG='h5000m-ttl'
NFT_DIR='/usr/share/nftables.d/chain-post/mangle_postrouting'
NFT_FILE="${NFT_DIR}/30-h5000m-ttl.nft"

enabled=$(uci -q get h5000m-ttl.settings.enabled) || enabled=0
value=$(uci -q get h5000m-ttl.settings.value) || value=64
iface=$(uci -q get h5000m-ttl.settings.interface) || iface=cellular
manage_offload=$(uci -q get h5000m-ttl.settings.manage_offload)
[ -n "$manage_offload" ] || manage_offload=1

changed=0

# Turn flow offloading off so our postrouting rule is actually reached. Offloaded flows are
# handled in the ingress fast path and never traverse postrouting, so with offloading on the
# rule silently applies to only the first packets of a flow - see the config comment. Only
# touches the flags that are not already 0, and reports "changed" (=> reload) only if it did.
disable_offload() {
	_did=0
	if [ "$(uci -q get firewall.@defaults[0].flow_offloading)" != 0 ]; then
		uci -q set firewall.@defaults[0].flow_offloading=0
		_did=1
	fi
	if [ "$(uci -q get firewall.@defaults[0].flow_offloading_hw)" != 0 ]; then
		uci -q set firewall.@defaults[0].flow_offloading_hw=0
		_did=1
	fi
	if [ "$_did" = 1 ]; then
		uci -q commit firewall
		logger -t "$TAG" "flow offloading disabled: it bypasses netfilter, so offloaded flows would keep a decremented TTL and defeat the rewrite (set manage_offload=0 to opt out)"
		return 0
	fi
	return 1
}

# Write $NFT_FILE only when its contents would actually change, so an ifupdate that reports
# the same device does not churn a fw4 reload (which briefly disrupts forwarding).
install_file() {
	_content="$1"
	if [ -f "$NFT_FILE" ] && [ "$(cat "$NFT_FILE" 2>/dev/null)" = "$_content" ]; then
		return 1
	fi
	mkdir -p "$NFT_DIR" || return 1
	printf '%s\n' "$_content" > "$NFT_FILE"
	return 0
}

if [ "$enabled" = 1 ]; then
	# Sanitize the value: an out-of-range or non-numeric setting must never make it into the
	# ruleset (a bad token fails the whole atomic fw4 reload, taking the firewall down).
	case "$value" in
		''|*[!0-9]*) value=64 ;;
	esac
	if [ "$value" -lt 1 ] || [ "$value" -gt 255 ]; then
		value=64
	fi

	dev=''
	network_get_device dev "$iface"
	if [ -z "$dev" ]; then
		# Interface is down / not created yet. Do NOT delete an existing good rule just
		# because the device is momentarily absent; the hotplug hook will re-run us on ifup.
		logger -t "$TAG" "interface '$iface' has no L3 device yet; leaving TTL rule as-is"
		exit 0
	fi

	# RULE LINES ONLY - no chain wrapper. This file is included INSIDE fw4's existing
	# mangle_postrouting base chain, so declaring a chain here would nest one inside another
	# and fail the load. `counter` makes hits visible in `nft list` for debugging, though a
	# non-zero count does NOT prove the TTL on the wire - see the verification note below.
	# The ip/ip6 statements are family-guarded by nft's implicit l3proto dependency, so each
	# only fires on its own address family.
	rule=$(cat <<EOF
# Generated by $TAG - do not edit; regenerated from /etc/config/h5000m-ttl.
oifname "$dev" counter ip ttl set $value
oifname "$dev" counter ip6 hoplimit set $value
EOF
)
	install_file "$rule" && changed=1

	if [ "$manage_offload" = 1 ]; then
		disable_offload && changed=1
	fi
else
	# Disabled: remove our include so fw4 stops carrying the rule. We deliberately do NOT
	# re-enable flow offloading here - we cannot know whether the user wanted it on, and
	# silently flipping a firewall default back is worse than leaving it where it is.
	if [ -f "$NFT_FILE" ]; then
		rm -f "$NFT_FILE"
		changed=1
	fi
fi

# One reload covers both the .nft include and any offload flag change. Best-effort: a fw4
# failure must not leave this script returning non-zero to a hotplug caller.
if [ "$changed" = 1 ]; then
	fw4 reload >/dev/null 2>&1 || logger -t "$TAG" "fw4 reload failed after TTL update"
fi

exit 0
