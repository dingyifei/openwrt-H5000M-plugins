#!/bin/sh
# H5000M Travelmate defaults — idempotent first-boot setup.
# Reaps a stale placeholder STA VIF and establishes the trm_wwan DHCP interface with its
# wan-zone firewall membership — the parts Travelmate genuinely needs from us.
#
# Hard rules: preserve discovered AP sections; no baked SSID/PSK; never assume mtwifi/.dat.
#
# No `set -e`: uci -q get on an absent key returns non-zero, which would abort the
# script under set -e. Matches 90-h5000m-base; each step below is individually idempotent.

# --- Remove a stale placeholder STA VIF, if a prior release left one -----------
# We used to CREATE a disabled, SSID-less STA VIF here as a "placeholder" for Travelmate to
# fill in. Travelmate does not work that way: f_setif() reads a section's EXISTING ssid/bssid
# and matches it against its @uplink[] list — it never WRITES an SSID. A section with no SSID
# therefore matches no uplink, resolves enabled=0, and is force-disabled forever, while LuCI
# renders it as "SSID: ?" (a blank, mode=Client, "wireless disabled" ghost). luci-app-travelmate
# creates and populates its own wifi-iface when you add an uplink, so no placeholder is wanted.
#
# So we no longer create the section; we remove the orphan a prior release created — but ONLY
# when all three hold: mode='sta' AND network='trm_wwan' AND ssid is absent/empty. A section
# with an SSID is a real uplink the user configured and MUST survive untouched; that guard is
# the entire safety of this change. Discover by attribute, never by index. AP sections
# (mode='ap') fail the first test and are never considered.
for iface in $(uci -q show wireless | sed -n 's/^\(wireless\.[^.]*\)=wifi-iface$/\1/p'); do
	[ "$(uci -q get "${iface}.mode")" = 'sta' ] || continue
	[ "$(uci -q get "${iface}.network")" = 'trm_wwan' ] || continue
	[ -z "$(uci -q get "${iface}.ssid")" ] || continue
	uci -q delete "$iface"
	# Log because we removed a section the user did not ask us to, matching this file's
	# convention for silent state changes. Guarded above, so nothing is logged on a clean run.
	logger -t h5000m-travelmate "removed orphaned SSID-less STA VIF ${iface#wireless.} (unusable by Travelmate)"
done

# --- Preserve AP sections: we never touch mode='ap'; the base owns those. ------

# --- Network: trm_wwan as DHCP, only if absent (never clobber an existing proto).
if [ "$(uci -q get network.trm_wwan)" != 'interface' ]; then
	uci -q set network.trm_wwan=interface
	uci -q set network.trm_wwan.proto='dhcp'
fi

# --- Firewall: add trm_wwan to the wan zone (found by name, never by index). ----
wan_zone=''
for zone in $(uci -q show firewall | sed -n 's/^\(firewall\.[^.]*\)=zone$/\1/p'); do
	if [ "$(uci -q get "${zone}.name")" = 'wan' ]; then
		wan_zone="$zone"
		break
	fi
done
if [ -n "$wan_zone" ]; then
	member=0
	for net in $(uci -q get "${wan_zone}.network"); do
		[ "$net" = 'trm_wwan' ] && member=1
	done
	[ "$member" -eq 1 ] || uci -q add_list "${wan_zone}.network=trm_wwan"
fi

uci -q commit wireless
uci -q commit network
uci -q commit firewall

exit 0
