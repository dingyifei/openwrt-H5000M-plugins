#!/bin/sh
# h5000m-sms - thin wrapper running upstream sms_tool under the FM350 AT-port lease.
#
# WHY a wrapper at all: the FM350-GL exposes exactly ONE working AT port (verified on this
# unit - see h5000m-modem-atd). sms_tool wants `-d /dev/ttyUSBx` and opens it directly,
# which would collide with the dialer's status polling and desynchronise both. at-lease
# takes the same flock every other AT consumer takes, holds it for sms_tool's whole
# lifetime, and exports MODEM_AT_B - so no ttyUSB name is ever written down, which would be
# wrong anyway since they renumber across re-enumeration.
#
# This is deliberately the same shape as h5000m-esim: a pass-through, not a new command
# vocabulary. Everything after the wrapper's own handling goes straight to sms_tool.
#
# UPSTREAM CONTRACT (obsy/sms_tool, packaged by OpenWrt as 'sms-tool', binary
# /usr/bin/sms_tool):
#   commands: send <number> <message> | recv | delete <index|all> | status | ussd <code>
#             | at <command>
#   options:  -d <tty> -b <baud> -f <datetime format> -j (JSON) -s <storage>
#             -r/-R (raw) -D (debug)
# `-j recv` is the form the LuCI backend uses; it emits JSON directly, so nothing here
# has to parse PDUs. sms_tool already handles PDU mode, UCS2 and multipart reassembly.

set -u

ATIO=/usr/lib/h5000m/atio.sh

usage() {
	cat <<'EOF'
Usage: h5000m-sms <sms_tool arguments...>

Thin wrapper around `sms_tool`, run under the FM350 AT-port lease so it can never
collide with the cellular dialer on the modem's single AT port. The serial device
is supplied automatically; all other arguments pass straight through.

Examples:
  h5000m-sms status              # storage counts and modem state
  h5000m-sms -j recv             # inbox as JSON
  h5000m-sms send 10086 "余额"    # send (number first, then the text)
  h5000m-sms delete 3            # delete one message by index
  h5000m-sms delete all          # empty the store

Storage:
  By default no storage is requested, so the modem's own default applies. That is
  deliberate. The FM350 AT manual (section 8.1.3) warns that the +CPMS selection
  "may be restored to SM after power cycle", so anything set once at install time
  silently reverts. Rather than depend on a setting that does not persist, this
  wrapper depends on none. To use ME storage (larger), export it - it is then
  re-applied on EVERY invocation, which is the only way a resetting setting can be
  relied on:
    H5000M_SMS_STORAGE=ME h5000m-sms -j recv

Run `sms_tool` with no arguments for its full usage.
EOF
}

case "${1:-}" in
	-h|--help|'')
		usage
		exit 0
		;;
esac

if ! command -v sms_tool >/dev/null 2>&1; then
	echo "h5000m-sms: sms_tool is not installed. Install the 'sms-tool' package." >&2
	echo "  (note the package is 'sms-tool' with a hyphen; the binary is sms_tool)" >&2
	exit 1
fi

if ! command -v at-lease >/dev/null 2>&1; then
	echo "h5000m-sms: at-lease not found - is h5000m-modem-atd installed?" >&2
	exit 1
fi

# Pre-flight the modem state so we can print something more actionable than a lock error.
# The state file path comes from atio.sh (H5000M_MODEM_STATE); never hard-coded here.
if [ -r "$ATIO" ]; then
	# shellcheck disable=SC1090
	. "$ATIO"
	if [ ! -r "$H5000M_MODEM_STATE" ]; then
		echo "h5000m-sms: no modem state at $H5000M_MODEM_STATE." >&2
		echo "  The FM350 AT port has not been discovered yet. Check the modem is" >&2
		echo "  powered/enumerated (try 'modem-ports') and h5000m-modem-atd is installed." >&2
		exit 1
	fi
fi

# Only inject -d / -s if the caller did not supply them, so the wrapper never overrides an
# explicit choice. Prefix matching covers both '-d /dev/x' and the '-d/dev/x' getopt form.
H5000M_SMS_WANT_D=1
H5000M_SMS_WANT_S="${H5000M_SMS_STORAGE:-}"
for _arg in "$@"; do
	case "$_arg" in
		-d|-d?*) H5000M_SMS_WANT_D=0 ;;
		-s|-s?*) H5000M_SMS_WANT_S='' ;;
	esac
done
export H5000M_SMS_WANT_D H5000M_SMS_WANT_S

# Hand the leased AT port to sms_tool. at-lease exports MODEM_AT_B into our child; the
# inner script prepends the options and execs. $0 is a label only - the user's arguments
# arrive as "$@".
exec at-lease sh -c '
	[ -n "$H5000M_SMS_WANT_S" ] && set -- -s "$H5000M_SMS_WANT_S" "$@"
	[ "$H5000M_SMS_WANT_D" = 1 ] && set -- -d "$MODEM_AT_B" "$@"
	exec sms_tool "$@"
' sms_tool "$@"
