# Pinned OpenWrt official SDK — MUST match the base image's revision/target/arch/kernel/ABI.
# Mirror of ../openwrt-H5000M/configs/official-base.env plus the SDK file+hash.
#
# ⚠️ PLACEHOLDERS below (___FILL_AFTER_REPIN___) are filled by the base SDK re-pin:
#   the base is re-pinned to a current snapshot that still ships a fetchable SDK, then the
#   SDK tarball is downloaded, sha256'd, PRESERVED (snapshots aren't re-downloadable), and
#   its name+hash recorded here. See ../openwrt-H5000M (WS-D-pre).

# --- must equal the base (kept in sync with official-base.env) ---
OPENWRT_REVISION=r35533-3b2bc55dcb
OPENWRT_BASE_URL=https://downloads.openwrt.org/snapshots/targets/mediatek/filogic
OPENWRT_TARGET=mediatek/filogic
OPENWRT_PROFILE=hiveton_h5000m
OPENWRT_ARCH=aarch64_cortex-a53
OPENWRT_KERNEL=6.18.39
OPENWRT_KERNEL_ABI=38ca7baf52c71e940d7f3ce0e127bcc9

# --- the SDK itself (preserved locally; snapshots roll ~hourly and are not archived) ---
OPENWRT_SDK_FILE=openwrt-sdk-mediatek-filogic_gcc-14.4.0_musl.Linux-x86_64.tar.zst
OPENWRT_SDK_SHA256=661c5b116528b5b028a0ff3d68cc3f931c9e41569d8e170f7d95656d438cb80d

# --- trust anchor (must equal the base's H5000M_PLUGIN_KEY_SHA256) ---
H5000M_PLUGIN_KEY_SHA256=ccb879ececd19bde222c8d1b36ba529c2420d260e767305edea5397ff15e10f7
