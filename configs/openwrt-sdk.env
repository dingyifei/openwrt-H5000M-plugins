# OpenWrt SDK source config — ROLLING model (matches the base's OPENWRT_ROLLING build).
#
# The SDK is fetched from the live snapshot mirror and integrity-checked against the
# mirror's own sha256sums (not a committed hash), because OpenWrt snapshots roll ~hourly
# and are not archived. The revision/kernel/ABI are whatever the live snapshot ships at
# build time; the ONLY hard rule is that the plugins and the base image must be built from
# the SAME snapshot (kmods are kernel-ABI-locked — though this feature set builds no kmods).

OPENWRT_ROLLING=1
OPENWRT_BASE_URL=https://downloads.openwrt.org/snapshots/targets/mediatek/filogic
OPENWRT_TARGET=mediatek/filogic
OPENWRT_PROFILE=hiveton_h5000m
OPENWRT_ARCH=aarch64_cortex-a53
OPENWRT_SDK_FILE=openwrt-sdk-mediatek-filogic_gcc-14.4.0_musl.Linux-x86_64.tar.zst

# Optional: to build against a SPECIFIC snapshot (e.g. to match a base built moments ago),
# set OPENWRT_REVISION here or in the environment; fetch-official-sdk.sh will warn on drift.
# OPENWRT_REVISION=

# trust anchor (must equal the base's H5000M_PLUGIN_KEY_SHA256)
H5000M_PLUGIN_KEY_SHA256=ccb879ececd19bde222c8d1b36ba529c2420d260e767305edea5397ff15e10f7
